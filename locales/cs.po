#: src/questions/04-resource-allocation.html.j2:274
#, python-format
msgid ""
"%(names)s is responsible for all issues relating to the protection of "
"personal data and data protection policies in general."
msgid_plural ""
"%(names)s are responsible for all issues relating to the protection of "
"personal data and data protection policies in general."
msgstr[0] ""
"%(names)s odpovídá za všechny záležitosti týkající se ochrany osobních údajů"
" a za zásady ochrany údajů obecně."
msgstr[1] ""
"%(names)s odpovídají za všechny záležitosti týkající se ochrany osobních "
"údajů a za zásady ochrany údajů obecně."
msgstr[2] ""
"%(names)s odpovídají za všechny záležitosti týkající se ochrany osobních "
"údajů a za zásady ochrany údajů obecně."

#: src/questions/04-resource-allocation.html.j2:266
#, python-format
msgid "%(names)s is responsible for finding, gathering, and collecting data."
msgid_plural "%(names)s are responsible for finding, gathering, and collecting data."
msgstr[0] "%(names)s odpovídá za vyhledávání, shromažďování a sběr dat."
msgstr[1] "%(names)s odpovídají za vyhledávání, shromažďování a sběr dat."
msgstr[2] "%(names)s odpovídají za vyhledávání, shromažďování a sběr dat."

#: src/questions/04-resource-allocation.html.j2:272
#, python-format
msgid ""
"%(names)s is responsible for generating and disseminating copies of the "
"resource in either electronic or print form."
msgid_plural ""
"%(names)s are responsible for generating and disseminating copies of the "
"resource in either electronic or print form."
msgstr[0] ""
"%(names)s odpovídá za vytváření a šíření kopií zdroje v elektronické nebo "
"tištěné podobě."
msgstr[1] ""
"%(names)s odpovídají za vytváření a šíření kopií zdroje v elektronické nebo "
"tištěné podobě."
msgstr[2] ""
"%(names)s odpovídají za vytváření a šíření kopií zdroje v elektronické nebo "
"tištěné podobě."

#: src/questions/04-resource-allocation.html.j2:262
#: src/questions/04-resource-allocation.html.j2:276
#, python-format
msgid ""
"%(names)s is responsible for implementing the DMP, and ensuring it is "
"reviewed and revised."
msgid_plural ""
"%(names)s are responsible for implementing the DMP, and ensuring it is "
"reviewed and revised."
msgstr[0] "%(names)s odpovídá za realizaci DMP a za to, že bude kontrolován a revidován."
msgstr[1] ""
"%(names)s odpovídají za realizaci DMP a za to, že bude kontrolován a "
"revidován."
msgstr[2] ""
"%(names)s odpovídají za realizaci DMP a za to, že bude kontrolován a "
"revidován."

#: src/questions/04-resource-allocation.html.j2:268
#, python-format
msgid "%(names)s is responsible for maintaining the finished resource."
msgid_plural "%(names)s are responsible for maintaining the finished resource."
msgstr[0] "%(names)s odpovídá za údržbu hotového zdroje."
msgstr[1] "%(names)s odpovídají za údržbu hotového zdroje."
msgstr[2] "%(names)s odpovídají za údržbu hotového zdroje."

#: src/questions/04-resource-allocation.html.j2:264
#, python-format
msgid ""
"%(names)s is responsible for reviewing, enhancing, cleaning, or "
"standardizing metadata and the associated data submitted for storage, use "
"and maintenance within a data centre or repository."
msgid_plural ""
"%(names)s are responsible for reviewing, enhancing, cleaning, or "
"standardizing metadata and the associated data submitted for storage, use "
"and maintenance within a data centre or repository."
msgstr[0] ""
"%(names)s odpovídá za kontrolu, rozšiřování, čištění nebo standardizaci "
"metadat a souvisejících dat předaných k uložení, používání a údržbě v "
"datovém centru nebo repozitáři."
msgstr[1] ""
"%(names)s odpovídají za kontrolu, rozšiřování, čištění nebo standardizaci "
"metadat a souvisejících dat předaných k uložení, používání a údržbě v "
"datovém centru nebo repozitáři."
msgstr[2] ""
"%(names)s odpovídají za kontrolu, rozšiřování, čištění nebo standardizaci "
"metadat a souvisejících dat předaných k uložení, používání a údržbě v "
"datovém centru nebo repozitáři."

#: src/questions/04-resource-allocation.html.j2:270
#, python-format
msgid ""
"%(names)s is responsible for the management and proficiency of data "
"including data processing, data policies, data guidelines, and data "
"availability."
msgid_plural ""
"%(names)s are responsible for the management and proficiency of data "
"including data processing, data policies, data guidelines, and data "
"availability."
msgstr[0] ""
"%(names)s odpovídá za správu a odbornou péči o data včetně zpracování dat, "
"datových politik, datových směrnic a dostupnosti dat."
msgstr[1] ""
"%(names)s odpovídají za správu a odbornou péči o data včetně zpracování dat,"
" datových politik, datových směrnic a dostupnosti dat."
msgstr[2] ""
"%(names)s odpovídají za správu a odbornou péči o data včetně zpracování dat,"
" datových politik, datových směrnic a dostupnosti dat."

