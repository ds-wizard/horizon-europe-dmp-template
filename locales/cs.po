msgstr[1] "%(names)s odpovídají za údržbu hotového zdroje."
msgstr[2] "%(names)s odpovídají za údržbu hotového zdroje."

#: src/questions/04-resource-allocation.html.j2:280
#, python-format
msgid ""
"%(names)s is responsible for reviewing, enhancing, cleaning, or "
"standardizing metadata and the associated data submitted for storage, use "
"and maintenance within a data centre or repository."
msgid_plural ""
"%(names)s are responsible for reviewing, enhancing, cleaning, or "
"standardizing metadata and the associated data submitted for storage, use "
"and maintenance within a data centre or repository."
msgstr[0] ""
"%(names)s odpovídá za kontrolu, rozšiřování, čištění nebo standardizaci "
"metadat a souvisejících dat předaných k uložení, používání a údržbě v "
"datovém centru nebo repozitáři."
msgstr[1] ""
"%(names)s odpovídají za kontrolu, rozšiřování, čištění nebo standardizaci "
"metadat a souvisejících dat předaných k uložení, používání a údržbě v "
"datovém centru nebo repozitáři."
msgstr[2] ""
"%(names)s odpovídají za kontrolu, rozšiřování, čištění nebo standardizaci "
"metadat a souvisejících dat předaných k uložení, používání a údržbě v "
"datovém centru nebo repozitáři."

#: src/questions/04-resource-allocation.html.j2:286
#, python-format
msgid ""
"%(names)s is responsible for the management and proficiency of data "
"including data processing, data policies, data guidelines, and data "
"availability."
msgid_plural ""
"%(names)s are responsible for the management and proficiency of data "
"including data processing, data policies, data guidelines, and data "
"availability."
msgstr[0] ""
"%(names)s odpovídá za správu a odbornou péči o data včetně zpracování dat, "
"datových politik, datových směrnic a dostupnosti dat."
msgstr[1] ""
"%(names)s odpovídají za správu a odbornou péči o data včetně zpracování dat,"
" datových politik, datových směrnic a dostupnosti dat."
msgstr[2] ""
"%(names)s odpovídají za správu a odbornou péči o data včetně zpracování dat,"
" datových politik, datových směrnic a dostupnosti dat."

