#: src/questions/04-resource-allocation.html.j2:278
#: src/questions/04-resource-allocation.html.j2:292
#, python-format
msgid ""
"%(names)s is responsible for implementing the DMP, and ensuring it is "
"reviewed and revised."
msgid_plural ""
"%(names)s are responsible for implementing the DMP, and ensuring it is "
"reviewed and revised."
