<div id="dmp-versions">
  <table>
    <thead>
      <tr>
        <th colspan="3" class="title">{% trans %}History of changes{% endtrans %}</th>
      </tr>
      <tr>
        <th>{% trans %}Version{% endtrans %}</th>
        <th>{% trans %}Publication date{% endtrans %}</th>
        <th>{% trans %}Changes{% endtrans %}</th>
      </tr>
    </thead>
    <tbody>
      {% for version in dc.questionnaire.versions|reverse %}
        <tr>
          <td class="version-name">{{ version.name }}</td>
          <td class="version-date">{{ version.created_at|datetime_format("%d %b %Y") }}</td>
          <td class="version-changes">{{ version.description }}</td>
        </tr>
      {% else %}
        <tr>
          <td colspan="3" class="no-versions">{% trans %}There are no named versions{% endtrans %}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
