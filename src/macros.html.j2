      {%- if replyObject.url -%}
      <a href="{{ replyObject.url }}" target="_blank">{{ replyObject.name }}</a>
      {%- else -%}
      {{replyObject.name}}
      {%- endif -%}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    {{ reply.value.value.value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationValue(reply) -%}
