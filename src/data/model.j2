{#- Sets the codes of FALLBACK_VALUES in obj and the objects below it -#}
{%- macro fallback(obj) -%}
  {%- if obj is mapping -%}
    {%- if obj._value is none and obj._uuid in FALLBACK_VALUES -%}
      {%- do obj.update({'_value': FALLBACK_VALUES[obj._uuid]}) -%}
    {%- endif -%}
    {%- for k, v in obj.items() if not k.startswith('_') -%}{{ fallback(v) }}{%- endfor -%}
  {%- elif obj is sequence and obj is not string -%}
    {%- for item in obj -%}{{ fallback(item) }}{%- endfor -%}
  {%- endif -%}
{%- endmacro -%}

