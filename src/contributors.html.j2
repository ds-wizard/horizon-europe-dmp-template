{#- data -#}
{%- set contributors = [] -%}
{%- for contributor in x.administrativeInformation.contributors if contributor.name._value -%}
  {%- do contributors.append({
    'name': contributor.name._value,
    'email': contributor.email._value,
    'orcid': contributor.orcid if contributor.orcid._value is not none else none,
    'roles': contributor.roles|map(attribute='_label')|sort,
    'affiliation': contributor.affiliation if contributor.affiliation._value is not none else none,
  }) -%}
{%- endfor -%}
<div id="dmp-contributors">
  <h2>{% trans %}Contributors{% endtrans %}</h2>

  <p>{% trans count=globals.projectsCount %}The following contributors are related to the project of this DMP:{% pluralize %}The following contributors are related to the projects of this DMP:{% endtrans %}</p>

  {%- if contributors|length > 0 -%}
  <ul>
  {% for contributor in contributors %}
    <li class="contributor">
      <strong class="name">{{ contributor.name }}</strong>
      {%- if contributor.email and contributor.orcid %}
        <br>{{ macros.formatEmail(contributor.email) }}, {{ macros.orcid(contributor.orcid) }}
      {%- elif contributor.email %}
        <br>{{ macros.formatEmail(contributor.email) }}
      {%- elif contributor.orcid %}
        <br>{{ macros.orcid(contributor.orcid) }}
      {%- endif -%}
      {%- if contributor.roles|length > 0 %}
        <br>{% if contributor.roles|length == 1 %}{% trans %}Role{% endtrans %}{% else %}{% trans %}Roles{% endtrans %}{% endif %}: {% for role in contributor.roles %}<span class="role">{{ role }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
      {%- endif %}
      {%- if contributor.affiliation %}
        <br>{% trans %}Affiliation:{% endtrans %} <span class="affiliation">{{ macros.ror(contributor.affiliation) }}</span>
      {%- endif %}
    </li>
  {% endfor %}
  </ul>
  {%- elif dc.project.created_by -%}
  <ul>
    <li class="contributor">
      <strong class="name">{{ dc.project.created_by.first_name }} {{ dc.project.created_by.last_name }}</strong>
      <br>{{ macros.formatEmail(dc.project.created_by.email) }}
      {%- if dc.project.created_by.affiliation %}
      <br>{% trans %}Affiliation:{% endtrans %} <span class="affiliation">{{ dc.project.created_by.affiliation }}</span>
      {%- endif %}
    </li>
  </ul>
  {%- else -%}
  <p class="empty-value"><em>{% trans %}There are no contributors described for this DMP.{% endtrans %}</em></p>
  {%- endif -%}
</div>
