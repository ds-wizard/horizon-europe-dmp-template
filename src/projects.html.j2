{#- data -#}
{%- set projects = x.administrativeInformation.projects -%}
<div id="dmp-projects">
  <h2>{% trans %}Projects{% endtrans %}</h2>

  {%- if projects|length > 0 %}
  <p>{% trans count=globals.projectsCount %}The data and work described in this DMP are for the following project.{% pluralize %}The data and work described in this DMP are for the following projects.{% endtrans %}</p>
  {%- endif %}

  {% for project in projects %}
    <div class="project">
    {%- set projectName = project.name._value -%}
    {%- if projectName -%}
      <h3>{{ projectName }}</h3>
    {%- else -%}
      <h3 class="empty-value">{% trans %}(project name not given){% endtrans %}</h3>
    {%- endif -%}

    {%- set projectAcronym = project.acronym._value -%}
    {%- set projectNumber = project.id._value -%}
    {%- set projectStart = project.startDate._value -%}
    {%- set projectEnd = project.endDate._value -%}
    {%- set fundings = project.fundings -%}
      <table class="project-details">
        <colgroup><col width="28%"><col width="72%"></colgroup>
        <tr><th>{% trans %}Acronym{% endtrans %}</th><td>{{ projectAcronym if projectAcronym else _("N/A") }}</td></tr>
        <tr><th>{% trans %}Project Number{% endtrans %}</th><td>{{ projectNumber if projectNumber else _("N/A") }}</td></tr>
        <tr><th>{% trans %}Start date{% endtrans %}</th><td>{{ projectStart if projectStart else _("N/A") }}</td></tr>
        <tr><th>{% trans %}End date{% endtrans %}</th><td>{{ projectEnd if projectEnd else _("N/A") }}</td></tr>
        <tr><th>{% trans %}Funding{% endtrans %}</th><td>
          {%- if fundings|length > 0 %}
            <ul>
            {%- for funding in fundings %}
              {%- set grantNumber = funding.grantNumber._value -%}
              {%- set funderStatus = funding.status._value %}
              <li>{{ macros.crossref(funding.funder) }}: {{ grantNumber if grantNumber else _("grant number not yet given") }} {% if funderStatus == 'planned' %}{% trans %}(planned){% endtrans %}{% elif funderStatus == 'applied' %}{% trans %}(applied){% endtrans %}{% elif funderStatus == 'granted' %}{% trans %}(granted){% endtrans %}{% elif funderStatus == 'rejected' %}{% trans %}(rejected){% endtrans %}{% endif %}</li>
            {%- endfor %}
            </ul>
          {%- else -%}
            {% trans %}Did not apply for any funding yet.{% endtrans %}
          {%- endif -%}
        </td></tr>
      </table>

    {%- set projectAbstract = project.abstract._value -%}
    {%- if projectAbstract %}
      <section class="abstract">
        {{ projectAbstract|markdown }}
      </section>
    {%- endif -%}
    </div>
  {% else %}
    <p class="empty-value"><em>{% trans %}There are no projects described for this DMP.{% endtrans %}</em></p>
  {% endfor %}
</div>
