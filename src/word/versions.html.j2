<h2>{% trans %}History of changes{% endtrans %}</h2>

{% if dc.questionnaire.versions|length > 0 %}
<table>
  <thead>
    <tr>
      <th>{% trans %}Version{% endtrans %}</th>
      <th>{% trans %}Publication date{% endtrans %}</th>
      <th>{% trans %}Changes{% endtrans %}</th>
    </tr>
  </thead>
  <tbody>
  {% for version in dc.questionnaire.versions|reverse %}
    <tr>
      <td>{{ version.name }}</td>
      <td>{{ version.created_at|datetime_format("%d %b %Y") }}</td>
      <td>{{ version.description }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p><em>{% trans %}There are no named versions.{% endtrans %}</em></p>
{% endif %}
