<div id="q-other-outputs" class="question">
  <div class="answer">
    {%- set serviceLink -%}<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_name }}</a>{%- endset %}
    <p>{% trans service=serviceLink %}We use {{ service }} for planning our data management and creating this DMP. The management and planning of other research outputs is done separately and is included in this Section. Still, we benefit from data stewardship guidance (e.g. FAIR principles, openness, or security) and it is reflected in our plans with respect to other research outputs.{% endtrans %}</p>

  {# Other outputs decision #}
  {%- set otherOutputsDecisionPath = [uuids.otherOutCUuid, uuids.otherOutDecisionQUuid ]|reply_path -%}
  {%- set otherOutputDecisionAUuid = repliesMap[otherOutputsDecisionPath]|reply_str_value -%}
  {%- if otherOutputDecisionAUuid -%}
    {% call macros.para() %}{% trans value=(otherOutputDecisionAUuid|trim|dot) %}We decide which additional research outputs should be retained as follows: {{ value }}{% endtrans %}{% endcall %}
  {%- endif -%}

  {# Other outputs #}
  {%- set otherOutputsPath = [uuids.otherOutCUuid, uuids.otherOutQUuid]|reply_path -%}
  {%- set otherOutputsAUuid = repliesMap[otherOutputsPath]|reply_str_value -%}
  {%- if otherOutputsAUuid == uuids.otherOutYesAUuid -%}

    {# Software #}
    {%- set otherOutputsSwPath = [otherOutputsPath, uuids.otherOutYesAUuid, uuids.swQUuid ]|reply_path -%}
    {%- set swAUuid = repliesMap[otherOutputsSwPath]|reply_str_value -%}
    {%- if swAUuid == uuids.swYesAUuid -%}
      {%- set swPath = [otherOutputsSwPath, uuids.swYesAUuid, uuids.swListQUuid]|reply_path -%}
      {%- set swList = repliesMap[swPath]|reply_items -%}

      {%- if swList|length > 0 -%}
        <p>{% trans %}We plan to produce the following software as additional research outputs:{% endtrans %}</p>
        <ul>
          {%- for sw in swList -%}
            <li>
              {%- set pathPrefix = [swPath, sw]|reply_path -%}
              {%- set swPackagePath = [pathPrefix, uuids.swPackageQUuid]|reply_path -%}
              {%- set swPackage = repliesMap[swPackagePath]|reply_str_value -%}
              {%- set swOpenLicensePath = [pathPrefix, uuids.swOpenLicenseQUuid]|reply_path -%}
              {%- set swOpenLicenseAUuid = repliesMap[swOpenLicensePath]|reply_str_value -%}
              {%- set swWhereAvailablePath = [pathPrefix, uuids.swWhereAvailableQUuid]|reply_path -%}
              {%- set swWhereAvailable = repliesMap[swWhereAvailablePath]|reply_str_value -%}
              {%- set swListedInCataloguePath = [pathPrefix, uuids.swListedInCatalogueQUuid]|reply_path -%}
              {%- set swListedInCatalogueAUuid = repliesMap[swListedInCataloguePath]|reply_str_value -%}
              {%- if swPackage -%}
                <strong>{{ swPackage }}</strong>
              {%- else -%}
                <strong>{% trans %}Unnamed software package{% endtrans %}</strong>
              {%- endif -%}
              <br>
              {%- if swOpenLicenseAUuid == uuids.swOpenLicenseNoAUuid -%}
                {% trans %}It will not be released under an open source license.{% endtrans %}
              {%- elif swOpenLicenseAUuid == uuids.swOpenLicenseYesDecidedAUuid -%}
                {%- set swOpenLicenseNamePath = [swOpenLicensePath, uuids.swOpenLicenseYesDecidedAUuid, uuids.swOpenLicenseYesNameQUuid]|reply_path -%}
                {%- set swOpenLicenseName = repliesMap[swOpenLicenseNamePath] -%}
                {%- if swOpenLicenseName -%}
                  {% trans value=(macros.integrationLicense(swOpenLicenseName)) %}It will be released under the open source license <em>{{ value }}</em>.{% endtrans %}
                {%- else -%}
                  {% trans %}It will be released under an open source license.{% endtrans %}
                {%- endif -%}
              {%- elif swOpenLicenseAUuid == uuids.swOpenLicenseYesUndecidedAUuid -%}
                {% trans %}It will be released under an open source license, which we will decide on.{% endtrans %}
              {%- endif -%}

              {%- if swWhereAvailable %}
                {%- if swListedInCatalogueAUuid == uuids.swListedInCatalogueYesAUuid %}
                  {% trans where=swWhereAvailable %}The software will be made available at {{ where }} and will be listed in a software catalogue.{% endtrans %}
                {%- elif swListedInCatalogueAUuid == uuids.swListedInCatalogueNoAUuid %}
                  {% trans where=swWhereAvailable %}The software will be made available at {{ where }} and will not be listed in a software catalogue.{% endtrans %}
                {%- else %}
                  {% trans where=swWhereAvailable %}The software will be made available at {{ where }}.{% endtrans %}
                {%- endif -%}
              {%- else -%}
                {%- if swListedInCatalogueAUuid == uuids.swListedInCatalogueYesAUuid %}
                  {% trans %}The software will be listed in a software catalogue.{% endtrans %}
                {%- elif swListedInCatalogueAUuid == uuids.swListedInCatalogueNoAUuid %}
                  {% trans %}The software will not be listed in a software catalogue.{% endtrans %}
                {%- endif -%}
              {%- endif -%}
               
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}

    {# Other #}
    {%- set otherOutputsNoSwPath = [otherOutputsPath, uuids.otherOutYesAUuid, uuids.otherOutputsNoSwQUuid ]|reply_path -%}
    {%- set otherAUuid = repliesMap[otherOutputsNoSwPath]|reply_str_value -%}
    {%- if otherAUuid == uuids.otherOutputsYesAUuid -%}
      {%- set otherPath = [otherOutputsNoSwPath, uuids.otherOutputsYesAUuid, uuids.otherOutputsListQUuid]|reply_path -%}
      {%- set otherList = repliesMap[otherPath]|reply_items -%}

      {%- if otherList|length > 0 -%}
        <p>{% trans %}We plan to produce the following additional research outputs:{% endtrans %}</p>
        <ul>
          {%- for other in otherList -%}
            <li>
              {%- set otherOutputPath = [otherPath, other]|reply_path -%}
              {%- set otherOutputNamePath = [otherOutputPath, uuids.otherOutputNameQUuid]|reply_path -%}
              {%- set otherOutputNameReply = repliesMap[otherOutputNamePath]|reply_str_value -%}
              {%- set otherOutputWhyValuablePath = [otherOutputPath, uuids.otherOutputWhyValuableQUuid]|reply_path -%}
              {%- set otherOutputWhyValuableReply = repliesMap[otherOutputWhyValuablePath]|reply_str_value -%}
              {%- set otherOutputWhoReusePath = [otherOutputPath, uuids.otherOutputWhoReuseQUuid]|reply_path -%}
              {%- set otherOutputWhoReuseReply = repliesMap[otherOutputWhoReusePath]|reply_str_value -%}
              {%- set otherOutputAvailablePath = [otherOutputPath, uuids.otherOutputAvailableQUuid]|reply_path -%}
              {%- set otherOutputAvailableReply = repliesMap[otherOutputAvailablePath]|reply_str_value -%}

              {%- if otherOutputNameReply -%}
                <strong>{{ otherOutputNameReply }}</strong>
              {%- else -%}
                <strong>{% trans %}Unnamed research output{% endtrans %}</strong>
              {%- endif -%}
              <br>
              {%- if otherOutputWhyValuableReply %}
                {% trans value=(otherOutputWhyValuableReply|trim|dot) %}It is valuable because {{ value }}{% endtrans %}
              {%- endif -%}

              {%- if otherOutputWhoReuseReply %}
                {% trans who=otherOutputWhoReuseReply %}It is expected to be reused by <em>{{ who }}</em>.{% endtrans %}
              {%- endif -%}

              {%- if otherOutputAvailableReply == uuids.otherOutputAvailableYesAUuid %}
                {%- set otherOutputWherePath = [otherOutputAvailablePath, uuids.otherOutputAvailableYesAUuid, uuids.otherOutputAvailableWhereQUuid]|reply_path -%}
                {%- set otherOutputWhereReply = repliesMap[otherOutputWherePath]|reply_str_value -%}
                  {%- if otherOutputWhereReply %}
                  {% trans where=otherOutputWhereReply %}It will be made available at <em>{{ where }}</em>.{% endtrans %}
                  {%- else %}
                  {% trans %}It will be made available.{% endtrans %}
                  {%- endif -%}

              {%- elif otherOutputAvailableReply == uuids.otherOutputAvailableNoAUuid %}
                {%- set otherOutputReasonPath = [otherOutputAvailablePath, uuids.otherOutputAvailableNoAUuid, uuids.otherOutputAvailableNoReasonQUuid]|reply_path -%}
                {%- set otherOutputReasonReply = repliesMap[otherOutputReasonPath]|reply_str_value -%}
                  {%- if otherOutputReasonReply %}
                  {% trans reason=otherOutputReasonReply %}It will not be made available because <em>{{ reason }}</em>.{% endtrans %}
                  {%- else %}
                  {% trans %}It will not be made available.{% endtrans %}
                  {%- endif -%}
              {%- endif -%}
              
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  {%- elif otherOutputsAUuid == uuids.otherOutNoAUuid -%}
    <p>{% trans %}There are no additional research outputs beyond those already described above.{% endtrans %}</p>
  {%- endif -%}
    
  </div>
</div>
