{#- data -#}
{%- set otherOutputs = x.otherOutputs -%}
{%- set hasOtherOutputs = otherOutputs.hasOtherOutputs -%}
<div id="q-other-outputs" class="question">
  <div class="answer">
    {%- set serviceLink -%}<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_name }}</a>{%- endset %}
    <p>{% trans service=serviceLink %}We use {{ service }} for planning our data management and creating this DMP. The management and planning of other research outputs is done separately and is included in this Section. Still, we benefit from data stewardship guidance (e.g. FAIR principles, openness, or security) and it is reflected in our plans with respect to other research outputs.{% endtrans %}</p>

  {# Other outputs decision #}
  {%- set otherOutputDecisionAUuid = otherOutputs.howOtherOutputs._value -%}
  {%- if otherOutputDecisionAUuid -%}
    {% call macros.para() %}{% trans value=(otherOutputDecisionAUuid|trim|dot) %}We decide which additional research outputs should be retained as follows: {{ value }}{% endtrans %}{% endcall %}
  {%- endif -%}

  {# Other outputs #}
  {%- if hasOtherOutputs._value == true -%}

    {# Software #}
    {%- set hasSoftwarePackages = hasOtherOutputs.hasSoftwarePackages -%}
    {%- if hasSoftwarePackages._value == true -%}
      {%- set swList = hasSoftwarePackages.softwarePackages -%}

      {%- if swList|length > 0 -%}
        <p>{% trans %}We plan to produce the following software as additional research outputs:{% endtrans %}</p>
        <ul>
          {%- for sw in swList -%}
            <li>
              {%- set swPackage = sw.name._value -%}
              {%- set swOpenLicense = sw.openSource._value -%}
              {%- set swWhereAvailable = sw.where._value -%}
              {%- set swListedInCatalogue = sw.catalogue._value -%}
              {%- if swPackage -%}
                <strong>{{ swPackage }}</strong>
              {%- else -%}
                <strong>{% trans %}Unnamed software package{% endtrans %}</strong>
              {%- endif -%}
              <br>
              {#- the licence question has the answers No and Yes (with the licence) -#}
              {%- if swOpenLicense == 'no' -%}
                {% trans %}It will not be released under an open source license.{% endtrans %}
              {%- elif swOpenLicense == 'decided' -%}
                {%- set swOpenLicenseName = sw.openSource.license -%}
                {%- if swOpenLicenseName._value is not none -%}
                  {% trans value=(macros.license(swOpenLicenseName)) %}It will be released under the open source license <em>{{ value }}</em>.{% endtrans %}
                {%- else -%}
                  {% trans %}It will be released under an open source license.{% endtrans %}
                {%- endif -%}
              {%- endif -%}

              {%- if swWhereAvailable %}
                {%- if swListedInCatalogue == true %}
                  {% trans where=swWhereAvailable %}The software will be made available at {{ where }} and will be listed in a software catalogue.{% endtrans %}
                {%- elif swListedInCatalogue == false %}
                  {% trans where=swWhereAvailable %}The software will be made available at {{ where }} and will not be listed in a software catalogue.{% endtrans %}
                {%- else %}
                  {% trans where=swWhereAvailable %}The software will be made available at {{ where }}.{% endtrans %}
                {%- endif -%}
              {%- else -%}
                {%- if swListedInCatalogue == true %}
                  {% trans %}The software will be listed in a software catalogue.{% endtrans %}
                {%- elif swListedInCatalogue == false %}
                  {% trans %}The software will not be listed in a software catalogue.{% endtrans %}
                {%- endif -%}
              {%- endif -%}
               
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}

    {# Other #}
    {%- set hasNonSoftwareOutputs = hasOtherOutputs.hasNonSoftwareOutputs -%}
    {%- if hasNonSoftwareOutputs._value == true -%}
      {%- set otherList = hasNonSoftwareOutputs.outputs -%}

      {%- if otherList|length > 0 -%}
        <p>{% trans %}We plan to produce the following additional research outputs:{% endtrans %}</p>
        <ul>
          {%- for other in otherList -%}
            <li>
              {%- set otherOutputNameReply = other.output._value -%}
              {%- set otherOutputWhyValuableReply = other.howValuable._value -%}
              {%- set otherOutputWhoReuseReply = other.forWhom._value -%}
              {%- set otherOutputAvailable = other.available -%}

              {%- if otherOutputNameReply -%}
                <strong>{{ otherOutputNameReply }}</strong>
              {%- else -%}
                <strong>{% trans %}Unnamed research output{% endtrans %}</strong>
              {%- endif -%}
              <br>
              {%- if otherOutputWhyValuableReply %}
                {% trans value=(otherOutputWhyValuableReply|trim|dot) %}It is valuable because {{ value }}{% endtrans %}
              {%- endif -%}

              {%- if otherOutputWhoReuseReply %}
                {% trans who=otherOutputWhoReuseReply %}It is expected to be reused by <em>{{ who }}</em>.{% endtrans %}
              {%- endif -%}

              {%- if otherOutputAvailable._value == true %}
                {%- set otherOutputWhereReply = otherOutputAvailable.where._value -%}
                  {%- if otherOutputWhereReply %}
                  {% trans where=otherOutputWhereReply %}It will be made available at <em>{{ where }}</em>.{% endtrans %}
                  {%- else %}
                  {% trans %}It will be made available.{% endtrans %}
                  {%- endif -%}

              {%- elif otherOutputAvailable._value == false %}
                {%- set otherOutputReasonReply = otherOutputAvailable.whyNot._value -%}
                  {%- if otherOutputReasonReply %}
                  {% trans reason=otherOutputReasonReply %}It will not be made available because <em>{{ reason }}</em>.{% endtrans %}
                  {%- else %}
                  {% trans %}It will not be made available.{% endtrans %}
                  {%- endif -%}
              {%- endif -%}
              
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  {%- elif hasOtherOutputs._value == false -%}
    <p>{% trans %}There are no additional research outputs beyond those already described above.{% endtrans %}</p>
  {%- endif -%}
    
  </div>
</div>
