<div id="q-other-issues" class="question">
  <div class="answer">
    {%- set project_url = dc.config.client_url ~ "/projects/" ~ dc.project.uuid -%}
    {%- set serviceLink -%}<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_name }}</a>{%- endset -%}
    {%- set packageId -%}<span class="package-id"><span class="organization-id">{{ dc.pkg.organization_id }}</span>:<span class="km-id">{{ dc.pkg.km_id }}</span>:<span class="version">{{ dc.pkg.version }}</span></span>{%- endset -%}
    {%- set instanceLink -%}<a href="{{ dc.config.client_url }}" target="_blank">{{ dc.config.client_url }}</a>{%- endset -%}
    {%- set projectLink -%}<a href="{{ project_url }}" target="_blank">{{ project_url }}</a>{%- endset %}
    {#- TRANSLATORS: %(service)s is the name of the Wizard as a link, %(instance)s the URL of the instance, %(project_url)s the URL of the project -#}
    <p>{% trans service=serviceLink, name=dc.pkg.name, id=packageId, instance=instanceLink, service_name_short=dc.config.service_name_short, project_url=projectLink %}We use the {{ service }} with its <em>{{ name }}</em> (ID: {{ id }}) knowledge model to make our DMP. More specifically, we use the {{ instance }} {{ service_name_short }} instance where the project has the direct URL: {{ project_url }}.{% endtrans %}</p>

    {# Applied policies #}
    {%- set policiesPath = [uuids.adminDetailsCUuid, uuids.policiesQUuid]|reply_path -%}
    {%- set policiesItems = repliesMap[policiesPath]|reply_items -%}
    {%- set policies = [] -%}
    {%- for item in policiesItems -%}
      {%- set name = repliesMap[[policiesPath, item, uuids.policiesNameQUuid]|reply_path]|reply_str_value -%}
      {%- set ref = repliesMap[[policiesPath, item, uuids.policiesReferenceQUuid]|reply_path]|reply_str_value -%}
      {%- set text = repliesMap[[policiesPath, item, uuids.policiesDescriptionQUuid]|reply_path]|reply_str_value -%}
      {%- if name or ref -%}
        {%- do policies.append({
          'name': name|trim|e,
          'ref': ref|trim|e,
          'text': text|trim|e,
        }) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if policies|length > 0 -%}
      <p>{% trans %}We will be using the following policies and procedures for data management:{% endtrans %}</p>
      <ul>
        {%- for policy in policies -%}
          <li>
            {% if policy.name %}
              <strong>{{ policy.name }}</strong> {% if policy.ref %}<br><a href="{{ policy.ref }}" target="_blank">{{ policy.ref }}</a>{% endif %}
            {% else %}
              <strong><a href="{{ policy.ref }}" target="_blank">{{ policy.ref }}</a></strong>
            {% endif %}
            {% if policy.text %}<br>{{ policy.text|markdown }}{% endif %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p>{% trans %}We will not be using any extra national, funder, sectoral, or departmental policies or procedures for data management.{% endtrans %}</p>
    {%- endif -%}
  </div>
</div>
