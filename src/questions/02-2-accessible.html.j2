{#- data -#}
{%- set access = x.givingAccessToData -%}
{%- set protocol = access.accessViaFreeStandardisedProtocol -%}
{%- set allOpen = access.allOpenOverTime -%}
{%- set embargo = access.useEmbargo -%}
{%- set openMetadata = access.openMetadata -%}
{%- set ownership = x.creatingData.collectedDataRights -%}
{%- set preexisting = x.reusingData.hasPreExistingData -%}
{%- set producedDataItems = x.preservingData.producedDatasets -%}
<div id="q-accessible" class="question">
  <div class="answer">
    {# Open philosophy #}
    {%- if access.asOpenAsPossible._value is true -%}
      <p>{% trans %}We will be working with the philosophy <em>as open as possible</em> for our data.{% endtrans %}</p>
    {%- endif -%}

    {# Free and standard protocol #}
    {%- if protocol._value is true -%}
      {%- set accessibleProtocolYesWhat = protocol.protocols._value -%}
      {%- if accessibleProtocolYesWhat -%}
      <p>{% trans protocol=(accessibleProtocolYesWhat|trim|dot) %}The data will be accessible through a free and standard protocol: {{ protocol }}{% endtrans %}
      </p>
      {%- else -%}
      <p>{% trans %}The data will be accessible through a free and standard protocol.{% endtrans %}</p>
      {%- endif -%}
    {%- elif protocol._value is false -%}
      {%- set accessibleProtocolNoWhy = protocol.reason._value -%}
      {%- if accessibleProtocolNoWhy -%}
      <p>{% trans reason=(accessibleProtocolNoWhy|trim|dot) %}The data will not be accessible through a free and standard protocol because: {{ reason }}{% endtrans %}
      </p>
      {%- else -%}
      <p>{% trans %}The data will not be accessible through a free and standard protocol.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}


    {# Can open data #}
    {%- if allOpen._value is true -%}
      <p>{% trans %}All of our data can become completely open over time.{% endtrans %}</p>
    {%- elif allOpen._value is false -%}
      {%- set notOpenBusinessReasonsOther = allOpen.businessReasons.other._value -%}
      {%- set notOpenOtherReasonsOther = allOpen.otherReasons.other._value -%}

      {%- set legalReasons = allOpen.legalReasons._value is true -%}
      {%- set businessReasonsPatents = allOpen.businessReasons._value == 'patents' -%}
      {%- set businessReasonsOther = allOpen.businessReasons._value == 'other' -%}
      {%- set otherReasonsPapers = allOpen.otherReasons._value == 'papers' -%}
      {%- set otherReasonsOther = allOpen.otherReasons._value == 'other' -%}
      {%- set anyReason = legalReasons or businessReasonsPatents or businessReasonsOther or otherReasonsPapers or otherReasonsOther -%}
      {%- set nReasons = [legalReasons, businessReasonsPatents, businessReasonsOther, otherReasonsPapers, otherReasonsOther]|sum -%}

      {%- if anyReason -%}
        {% call macros.para() %}
        {% trans %}The data cannot become completely open because{% endtrans %}
        {%- if nReasons == 1 -%}
          {%- if legalReasons %}
            {% trans %}of legal reasons.{% endtrans %}
          {%- elif businessReasonsPatents %}
            {% trans %}of patent-related business reasons.{% endtrans %}
          {%- elif businessReasonsOther %}
            {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ notOpenBusinessReasonsOther|markdown if notOpenBusinessReasonsOther else ".") %}of non-patent business reasons{{ value }}{% endtrans %}
          {%- elif otherReasonsPapers %}
            {% trans %}we want to publish a paper first.{% endtrans %}
          {%- elif otherReasonsOther %}
            {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ notOpenOtherReasonsOther|markdown if notOpenOtherReasonsOther else ".") %}we have other than paper-publishing reasons{{ value }}{% endtrans %}
          {%- endif -%}
        {%- else %}
          {% trans %}of:{% endtrans %}
          <ul>
            {%- if legalReasons %}
              <li>{% trans %}legal reasons{% endtrans %}</li>
            {%- endif -%}
            {%- if businessReasonsPatents %}
              <li>{% trans %}patent-related business reasons{% endtrans %}</li>
            {%- elif businessReasonsOther %}
              <li>{# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ notOpenBusinessReasonsOther|markdown if notOpenBusinessReasonsOther else "") %}non-patent business reasons{{ value }}{% endtrans %}</li>
            {%- endif -%}
            {%- if otherReasonsPapers %}
              <li>{% trans %}we want to publish a paper first{% endtrans %}</li>
            {%- elif otherReasonsOther -%}
              <li>{# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ notOpenOtherReasonsOther|markdown if notOpenOtherReasonsOther else "") %}we have other than paper-publishing reasons{{ value }}{% endtrans %}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}
        {% endcall %}

        {%- if legalReasons -%}
          {%- set authenticatedAccess = allOpen.legalReasons.authenticatedAccess -%}
          {%- if authenticatedAccess._value is true -%}
            {% call macros.para() %}
              {% trans %}Concerning the legal reasons, a data sharing agreement will be required.{% endtrans %}
              {%- set authorisation = authenticatedAccess.authorisation -%}
              {%- if authorisation._value == 'member' %}
                {% trans %}People can apply to one of the project members.{% endtrans %}
              {%- elif authorisation._value == 'committee' %}
                {% trans %}People can apply to the data access committee that we will set up.{% endtrans %}
              {%- elif authorisation._value == 'existingCommittee' %}
                {%- set legalReasonsAuthorizeOldCommittee = authorisation.committee._value -%}
                {%- if legalReasonsAuthorizeOldCommittee %}
                  {#- the name of the committee in italics, unless the answer has several lines (blocks) -#}
                {%- if '\n' in legalReasonsAuthorizeOldCommittee|trim %}
                  {% trans value=(legalReasonsAuthorizeOldCommittee|markdown) %}People can apply to the following data access committee: {{ value }}{% endtrans %}
                {%- else %}
                  {% trans value=(legalReasonsAuthorizeOldCommittee|markdown|replace("<p>", "")|replace("</p>", "")|trim) %}People can apply to the following data access committee: <em>{{ value }}</em>{% endtrans %}
                {%- endif -%}
                {%- else -%}
                  {% trans %}People can apply to an existing data access committee.{% endtrans %}
                {%- endif -%}
              {%- elif authorisation._value == 'other' %}
                {%- set legalReasonsAuthorizeOther = authorisation.other._value %}
                {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ legalReasonsAuthorizeOther|markdown if legalReasonsAuthorizeOther else ".") %}For the authorization of potential users, we will make special arrangements{{ value }}{% endtrans %}
              {%- endif -%}
            {% endcall %}
          {%- endif -%}
        {%- endif -%}

      {%- else -%}
        <p>{% trans %}The data can become completely open over time.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}

    {# Embargo #}
    {%- if embargo._value == 'noAllOpen' -%}
      <p>{% trans %}Limited embargo will not be used as all data will be opened immediately.{% endtrans %}</p>
    {%- elif embargo._value == 'noUnrestrictedOpen' -%}
      <p>{% trans %}Limited embargo cannot be used because some restricted data will be embargoed indefinitely.{% endtrans %}</p>
    {%- elif embargo._value == 'noOpenLegal' -%}
      <p>{% trans %}Data will be released only as soon as restrictions fall away.{% endtrans %}</p>
    {%- elif embargo._value == 'yesEmbargo' -%}
      {%- set embargoPeriod = embargo.period._value -%}
      {%- if embargoPeriod -%}
        <p>{% trans period=embargoPeriod %}Data that is not legally restricted will be released after a fixed time period ({{ period }}), unconditionally.{% endtrans %}</p>
      {%- else -%}
        <p>{% trans %}Data that is not legally restricted will be released after a fixed time period, unconditionally.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}

    {# Publishing metadata #}
    {%- if openMetadata._value is false %}
      {%- set explanation = openMetadata.explanation._value -%}
      {%- if explanation -%}
        {% call macros.para() %}{% trans value=(explanation|e|markdown) %}Metadata will not be available openly &ndash; {{ value }}{% endtrans %}{% endcall %}
      {%- else -%}
        <p>{% trans %}Metadata will not be available openly.{% endtrans %}</p>
      {%- endif -%}
    {%- elif openMetadata._value is true -%}
      {%- set metadataOpenInstr = openMetadata.accessInstructions._value -%}
      {%- set metadataOpenForm = openMetadata.harvestable._value -%}
      <p>
      {%- if metadataOpenInstr is false %}
        {% trans %}Metadata will be openly available without instructions on how to get access to the data.{% endtrans %}
      {%- elif metadataOpenInstr is true %}
        {% trans %}Metadata will be openly available including instructions on how to get access to the data.{% endtrans %}
      {%- else %}
        {% trans %}Metadata will be openly available.{% endtrans %}
      {%- endif %}
      {%- if metadataOpenForm == 'no' %}
        {% trans %}Metadata will not be available in a form that can be harvested and indexed.{% endtrans %}
      {%- elif metadataOpenForm == 'byRepository' %}
        {% trans %}Metadata will be available in a form that can be harvested and indexed (managed by the used repository / repositories).{% endtrans %}
      {%- elif metadataOpenForm == 'yes' %}
        {% trans %}Metadata will be available in a form that can be harvested and indexed.{% endtrans %}
      {%- endif %}
      </p>
    {%- endif -%}

    {# Ownership #}
    {%- if ownership._value == 'noCopyright' -%}
      <p>{% trans %}Our data is legally not copyrightable; there is no legal owner.{% endtrans %}</p>
    {%- elif ownership._value == 'pi' -%}
      <p>{% trans %}All data will be owned by the Principal Investigator.{% endtrans %}</p>
    {%- elif ownership._value == 'institute' -%}
      <p>{% trans %}All data will be owned by the institute.{% endtrans %}</p>
    {%- elif ownership._value == 'consortiumAgreement' -%}
      <p>{% trans %}We have a consortium agreement that arranges Intellectual Property.{% endtrans %}</p>
    {%- elif ownership._value == 'other' -%}
      {%- set ownershipOther = ownership.other._value -%}
      {%- if ownershipOther -%}
        {% call macros.para() %}{% trans value=(ownershipOther|markdown) %}We have made the following arrangements regarding the data ownership: {{ value }}{% endtrans %}{% endcall %}
      {%- endif -%}
    {%- endif -%}

    {# (Non)reference data - license #}
    {%- if preexisting._value is true -%}
      {%- set answeredRefData = [] -%}
      {%- for i in preexisting.referenceDatasets -%}
        {%- set isUsed = i.using._value is true -%}
        {%- set isAnswered = i.using.conditions._value is not none -%}
        {%- if isUsed and isAnswered -%}
          {%- do answeredRefData.append(i) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set answeredNRefData = [] -%}
      {%- for i in preexisting.nonReferenceDatasets -%}
        {%- set isUsed = i.using._value is true -%}
        {%- set isAnswered = i.using.conditions._value is not none -%}
        {%- if isUsed and isAnswered -%}
          {%- do answeredNRefData.append(i) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if (answeredRefData|length + answeredNRefData|length) > 0 -%}
        <p>{% trans %}For the reference and non-reference data sets that we reuse, conditions are as follows:{% endtrans %}</p>
        <ul>
          {%- for i in answeredRefData -%}
            {%- set refDataNameReply = i.dataset._value -%}
            {%- set refDataConditions = i.using.conditions._value -%}
            {%- if refDataConditions -%}
              <li>
                <div><strong>{{ refDataNameReply if refDataNameReply is not none else "" }}</strong></div>
                {% if refDataConditions == 'cc0' -%}
                  {% trans %}It is freely available for any use (public domain or CC0).{% endtrans %}
                {%- elif refDataConditions == 'cc-by' -%}
                  {% trans %}It is freely available with obligation to quote the source (e.g. CC-BY).{% endtrans %}
                {%- elif refDataConditions == 'restrictions' -%}
                  {%- set refDataConditionsOther = i.using.conditions.conditions._value -%}
                  {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans count=globals.projectsCount, value=(": " ~ refDataConditionsOther|markdown if refDataConditionsOther else ".") %}It is available under specific restrictions, which we will follow in our project{{ value }}{% pluralize %}It is available under specific restrictions, which we will follow in our projects{{ value }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- for i in answeredNRefData -%}
            {%- set nrefDataNameReply = i.dataset._value -%}
            {%- set nrefDataConditions = i.using.conditions._value -%}
            {%- if nrefDataConditions -%}
              <li>
                <div><strong>{{ nrefDataNameReply if nrefDataNameReply is not none else "" }}</strong></div>
                {% if nrefDataConditions == 'cc0' -%}
                  {% trans %}It is freely available for any use (public domain or CC0).{% endtrans %}
                {%- elif nrefDataConditions == 'cc-by' -%}
                  {% trans %}It is freely available with obligation to quote the source (e.g. CC-BY).{% endtrans %}
                {%- elif nrefDataConditions == 'restrictions' -%}
                  {%- set nrefDataConditionsOther = i.using.conditions.conditions._value -%}
                  {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans count=globals.projectsCount, value=(": " ~ nrefDataConditionsOther|markdown if nrefDataConditionsOther else ".") %}It is available under specific restrictions, which we will follow in our project{{ value }}{% pluralize %}It is available under specific restrictions, which we will follow in our projects{{ value }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}

    {# Produced datasets #}
    {%- if producedDataItems|length > 0 -%}
      <p>{% trans %}For our produced data, conditions are as follows:{% endtrans %}</p>
      <ul>
      {%- for i in producedDataItems -%}
        {%- set producedDataName = i.dataset._value -%}
        <li>
          <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong>
          {# If will be published #}
          {%- set published = i.published -%}
          {% if published._value is false %}
            {% trans %}(not published){% endtrans %}
          {% elif published._value is true %}
            {% trans %}(will be published){% endtrans %}
          {#- Distributions #}
          {% set distrosItems = published.distributions -%}
          {%- set distrosList -%}
            {%- for j in distrosItems -%}
              {%- set repository = j.repository -%}
              {%- set distroRepositoryKind = repository._value -%}
              {%- set distroShare = j.access._value -%}
              {%- if distroRepositoryKind -%}
                <li>
                  {%- if distroRepositoryKind == 'domainSpecific' %}
                    <em>{% trans %}Domain-specific repository{% endtrans %}</em>
                    {%- if repository.repository._value is not none -%}
                      : {{ macros.fairsharing(repository.repository) }}.
                    {%- else -%}.
                    {% endif -%}
                    {# Contact the repository #}
                    {%- set contactBefore = repository.contactBefore -%}
                    {%- if contactBefore._value == 'no' %}
                      {% trans %}We don't need to contact the repository because it is a routine for us.{% endtrans %}
                    {%- elif contactBefore._value == 'done' %}
                      {% trans %}We have already contacted the repository.{% endtrans %}
                    {%- elif contactBefore._value == 'will' %}
                      {% trans %}We are going to contact the repository.{% endtrans %}
                    {%- elif contactBefore._value == 'other' %}
                      {%- set domainSpecificRepoContactBeforeOther = contactBefore.other._value %}
                      {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ domainSpecificRepoContactBeforeOther|markdown if domainSpecificRepoContactBeforeOther else ".") %}We have made other arrangements{{ value }}{% endtrans %}
                    {%- endif -%}
                  {%- elif distroRepositoryKind == 'generalPurpose' %}
                    <em>{% trans %}General-purpose repository{% endtrans %}</em>
                    {%- if repository.repository._value is not none -%}
                      : {{ macros.fairsharing(repository.repository) }}.
                    {%- else -%}.
                    {% endif -%}
                  {%- elif distroRepositoryKind == 'national' %}
                    {% trans %}<em>Our national repository</em>.{% endtrans %}
                  {%- elif distroRepositoryKind == 'institutional' %}
                    {% trans %}<em>Our institutional repository</em>.{% endtrans %}
                  {%- elif distroRepositoryKind == 'specialPurpose' %}
                    {% trans count=globals.projectsCount %}<em>Special-purpose repository for the project</em>.{% pluralize %}<em>Special-purpose repository for the projects</em>.{% endtrans %}
                    {# Sharing #}
                    {%- if distroShare == 'open' %}
                      {% trans %}It will be <em>Open</em> (shared with anyone).{% endtrans %}
                    {%- elif distroShare == 'shared' %}
                      {% trans %}It will be <em>Shared</em> with a predefined list of people.{% endtrans %}
                    {%- elif distroShare == 'closed' %}
                      {% trans %}It will be <em>Closed</em> (not meant for sharing).{% endtrans %}
                    {%- endif %}
                    {# Long-term support #}
                    {%- if repository.longTermSupport._value is true %}
                      {% trans %}We will be able to support this repository for a sufficiently long time.{% endtrans %}
                    {%- endif -%}
                    {# Service level #}
                    {%- set specialRepoServiceLevel = repository.serviceLevel._value -%}
                    {%- if specialRepoServiceLevel == 'onlyDownload' %}
                      {% trans %}The repository will provide download-only service.{% endtrans %}
                    {%- elif specialRepoServiceLevel == 'simpleSearch' %}
                      {% trans %}The repository will provide a search and simple access interface.{% endtrans %}
                    {%- elif specialRepoServiceLevel == 'advanced' %}
                      {% trans %}The repository will provide an advanced processing service.{% endtrans %}
                    {%- endif -%}
                  {%- endif -%}

                  {# Licenses #}
                  {%- set licensesItems = j.licenses -%}
                  {%- if licensesItems|length > 0 %}
                    {% trans count=licensesItems|length %}The distribution will be available under the following license:{% pluralize %}The distribution will be available under the following licenses:{% endtrans %}
                    <ul>
                    {%- for k in licensesItems -%}
                      <li>
                      {%- set licenseStart = k.startDate._value -%}
                      {% if licenseStart %}
                        {% trans date=licenseStart %}Starting {{ date }}:{% endtrans %}
                      {% endif %}

                      {%- set license = k.license -%}
                      {%- if license._value == 'freeOpen' %}
                        {% trans %}Freely available for any use (public domain or CC0).{% endtrans %}
                      {%- elif license._value == 'freeOpenAttribution' %}
                        {% trans %}Freely available with obligation to quote the source (e.g. CC-BY).{% endtrans %}
                      {%- elif license._value == 'restrictions' -%}
                        {%- set licenseRestrictConditions = license.conditions._value -%}
                        {%- set licenseRestrictLink = license.licenseUrl._value -%}
                        {%- set licenseRestrictAccess = license.accessReusers._value -%}
                        {%- set licenseRestrictMetadata = license.inMetadata._value %}

                        {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans count=globals.projectsCount, value=(": " ~ licenseRestrictConditions|markdown if licenseRestrictConditions else ".") %}Available under some restrictions, which we will follow in our project{{ value }}{% pluralize %}Available under some restrictions, which we will follow in our projects{{ value }}{% endtrans %}
                        {%- if licenseRestrictAccess == 'contactPerson' %}
                          {% trans %}Re-users will be able to get access by request to the contact person.{% endtrans %}
                        {%- elif licenseRestrictAccess == 'committee' %}
                          {% trans count=globals.projectsCount %}Re-users will be able to get access through a <em>Data Access Committee</em> for the project.{% pluralize %}Re-users will be able to get access through a <em>Data Access Committee</em> for the projects.{% endtrans %}
                        {%- elif licenseRestrictAccess == 'other' -%}
                          {%- set licenseRestrictAccessAnother = license.accessReusers.other._value %}
                          {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ licenseRestrictAccessAnother|markdown if licenseRestrictAccessAnother else ".") %}Re-users will be able to get access through a specialized process{{ value }}{% endtrans %}
                        {%- endif -%}
                        {%- if licenseRestrictMetadata is true %}
                          {% trans %}The conditions will be published as part of open metadata.{% endtrans %}
                        {%- endif -%}
                        {% if licenseRestrictLink %}
                          {% trans %}More information about the restrictions can be found here:{% endtrans %} <a href="{{ licenseRestrictLink }}" target="_blank">{{ licenseRestrictLink }}</a>.
                        {% endif %}
                      {%- endif -%}
                      </li>
                    {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endset -%}
          {%- if distrosList|trim -%}
            <br>{% trans %}The distributions will be accessible through:{% endtrans %}
            <ul>{{ distrosList }}</ul>
          {%- endif -%}
          {# Software #}
          {%- set specificSw = published.specificSoftwareNeeded %}
          {%- if specificSw._value is false -%}
            {%- set specificSwWhy = specificSw.reason._value -%}
            <br>{% if specificSwWhy %}{% trans reason=(specificSwWhy|trim|dot) %}A user of this data can use it without any specific software because: {{ reason }}{% endtrans %}{% else %}{% trans %}A user of this data can use it without any specific software.{% endtrans %}{% endif %}
          {%- elif specificSw._value is true -%}
            {%- set publishedSpecSwWhatItems = specificSw.software %}
            {%- if publishedSpecSwWhatItems|length > 0 -%}
            <br>{% trans %}A user of this data needs specific software to be able to use it:{% endtrans %}
            <ul>
            {%- for sw in publishedSpecSwWhatItems -%}
              {%- set swName = sw.name._value -%}
              {%- set swPID = sw.pid._value -%}
              <li><strong>{{ swName if swName is not none else "" }}{% if swPID %} ({{ swPID }}){% endif %}</strong><br>
              {%- set swDocumentation = sw.docsInMetadata._value -%}
              {%- if swDocumentation is false %}
                {%- set swDocumentationNotWhy = sw.docsInMetadata.reason._value %}
                {% if swDocumentationNotWhy %}{% trans reason=(swDocumentationNotWhy|trim|dot) %}The documentation of this software will not be included in the metadata of this data set because: {{ reason }}{% endtrans %}{% else %}{% trans %}The documentation of this software will not be included in the metadata of this data set.{% endtrans %}{% endif %}

              {%- elif swDocumentation is true %}
                {% trans %}The documentation of this software will be included in the metadata of the data set.{% endtrans %}
              {%- endif -%}

              {%- set swIncluded = sw.included._value -%}
              {%- if swIncluded is false %}
                {% trans %}The software (e.g. in open source code) will not be included.{% endtrans %}
              {%- elif swIncluded is true %}
                {% trans %}The software (e.g. in open source code) will be included.{% endtrans %}
              {%- endif -%}

              </li>
            {%- endfor -%}
            </ul>
            {%- endif -%}
          {%- endif -%}
          {%- endif -%}

          {# When published #}
          {%- set publishedWhen = published.when._value if published._value is true else none -%}
          {%- if publishedWhen == 'afterCollecting' %}
            <br>{% trans %}The dataset will be published as soon as possible after collecting it.{% endtrans %}
          {%- elif publishedWhen == 'afterCleanup' %}
            <br>{% trans %}The dataset will be published after initial cleanup.{% endtrans %}
          {%- elif publishedWhen == 'afterProcessing' %}
            <br>{% trans %}The dataset will be published after all our processing has finished.{% endtrans %}
          {%- elif publishedWhen == 'afterProject' %}
            <br>{% trans count=globals.projectsCount %}The dataset will be published when the project is wrapped up.{% pluralize %}The dataset will be published when the projects are wrapped up.{% endtrans %}
          {%- elif publishedWhen == 'afterEmbargo' %}
            <br>{% trans %}The dataset will be published after an embargo.{% endtrans %}
          {%- endif %}
        </li>
      {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
