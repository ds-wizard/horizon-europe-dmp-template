{#- data -#}
{%- set measured = x.creatingData.hasMeasuredData -%}
{%- set nonMeasured = x.creatingData.hasNonMeasuredData -%}
{%- set preexisting = x.reusingData.hasPreExistingData -%}
{%- set formats = x.creatingData.usesDataFormats -%}
{%- set storageConv = x.processingData.storageNamingConventions -%}
<div id="q-data-summary" class="question">
  <div class="answer">

  {# Measured datasets #}
  {%- if measured._value is true -%}
    {%- set measuredDataItems = measured.datasets -%}
    {# Measured datasets #}
    {%- if measuredDataItems|length > 0 -%}
      <div>
      <h4>{% trans %}Instrument datasets{% endtrans %}</h4>
      <p>{% trans count=globals.projectsCount %}The following instrument datasets will be acquired in the project:{% pluralize %}The following instrument datasets will be acquired in the projects:{% endtrans %}</p>
      <ul>
        {%- for datasetItem in measuredDataItems -%}
          <li>
            {%- set measuredDataName = datasetItem.dataset._value -%}
            {%- set measuredDataWho = datasetItem.whoWhere -%}
            {%- set measuredDataEquip = datasetItem.isStandardAndWellDescribed._value -%}
            {%- set mdDataUtility = datasetItem.whoInterested -%}
            <strong>{{ measuredDataName if measuredDataName else _("(no name given)") }}</strong>
            {# Who will collect #}
            {%- if measuredDataWho._value == 'expertsOwn' -%}
              <p>{% trans count=globals.projectsCount %}This dataset will be collected by experts in the project, with our own equipment.{% pluralize %}This dataset will be collected by experts in the projects, with our own equipment.{% endtrans %}</p>
            {%- elif measuredDataWho._value == 'expertsSpecialised' -%}
              <p>{% trans count=globals.projectsCount %}This dataset will be collected by experts in the project, at a specialized infrastructure.{% pluralize %}This dataset will be collected by experts in the projects, at a specialized infrastructure.{% endtrans %}</p>
            {%- elif measuredDataWho._value == 'external' -%}
              {%- set mdExternalOwnership = measuredDataWho.ownership -%}
              {% call macros.para() %}
                {% trans %}This dataset will be collected by an external party.{% endtrans %}
                {% if mdExternalOwnership._value == 'external' -%}
                  {% trans %}The ownership of the resulting data will remain with the external party.{% endtrans %}
                {%- elif mdExternalOwnership._value == 'projectPartners' -%}
                  {% trans %}The project partners acquire full ownership of the data.{% endtrans %}
                {%- elif mdExternalOwnership._value == 'other' -%}
                  {%- set mdExternalOwnershipOther = mdExternalOwnership.other._value -%}
                  {%- if mdExternalOwnershipOther -%}
                    {% trans value=(mdExternalOwnershipOther|markdown) %}For the ownership of the data we have made the following arrangements: {{ value }}{% endtrans %}
                  {%- endif -%}
                {%- endif -%}
              {% endcall %}
            {%- endif -%}
            {# Equipment standard? #}
            {% if measuredDataEquip is true -%}
              <p>{% trans %}The equipment is very well described and known.{% endtrans %}</p>
            {%- elif measuredDataEquip is false -%}
              <p>{% trans %}The equipment is less well described or not completely standard, so we will need to take extra care documenting the process.{% endtrans %}</p>
            {%- endif -%}
            {# Data utility #}
            {% if mdDataUtility._value == 'justUs' -%}
              <p>{% trans %}This data are expected to be used only by us.{% endtrans %}</p>
            {%- elif mdDataUtility._value == 'sameField' -%}
              <p>{% trans %}Other researchers working in the same field of research could be interested in using this data.{% endtrans %}</p>
            {%- elif mdDataUtility._value == 'otherFields' -%}
              {%- set mdDataUtilityOtherFieldsHow = mdDataUtility.how._value -%}
              {% call macros.para() %}{% trans %}Researchers working in other fields of research could be interested in using this data.{% endtrans %} {% if mdDataUtilityOtherFieldsHow -%}{% trans value=(mdDataUtilityOtherFieldsHow|markdown) %}We think that other researchers can use this data as follows: {{ value }}{% endtrans %}{%- endif -%}{% endcall %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      </div>
    {%- endif -%}
  {%- endif -%}

  {# Non-equipment datasets #}
  {%- if nonMeasured._value is true -%}
    {%- set neqDataSetsItems = nonMeasured.datasets -%}

    {%- set questionnaires = nonMeasured.questionnaires._value is true -%}
    {%- set caseReport = nonMeasured.caseReportForms._value is true -%}
    {%- set eRecords = nonMeasured.patientRecords._value is true -%}
    {%- if questionnaires or caseReport or eRecords or neqDataSetsItems|length > 0 -%}
      <div>
      <h4>{% trans %}Non-equipment datasets{% endtrans %}</h4>
      {# Types #}
      {%- set typesNames = [] -%}
      {%- if questionnaires -%}{%- do typesNames.append(_("questionnaires")) -%}{%- endif -%}
      {%- if caseReport -%}{%- do typesNames.append(_("case report forms")) -%}{%- endif -%}
      {%- if eRecords -%}{%- do typesNames.append(_("electronic patient records")) -%}{%- endif -%}
      {%- set typesCount = typesNames|length -%}
      {% call macros.para() %}
        {%- if typesCount > 0 -%}
          {#- TRANSLATORS: %(types)s is an enumeration of questionnaires, case report forms, and electronic patient records -#}
          {% trans types=macros.joinAnd(typesNames) %}We collect data from {{ types }}.{% endtrans %}
        {% endif %}
        {# Datasets #}
        {%- if neqDataSetsItems|length > 0 -%}
          {% trans %}The non-equipment datasets are:{% endtrans %}
          <ul>
          {%- for neqDataSetItem in neqDataSetsItems -%}
            {%- set neqDataSetsName = neqDataSetItem.dataset._value -%}
            {%- set neqDataSetsDesc = neqDataSetItem.description._value -%}
            {%- set neqDataUtility = neqDataSetItem.whoInterested -%}
            <li>
              <strong>{{ neqDataSetsName if neqDataSetsName else _("(no name given)") }}</strong>
              {% if neqDataSetsDesc -%}<span class="separator">&ndash;</span> {{ neqDataSetsDesc|markdown }}{%- endif -%}
              {# Data utility #}
              {% if neqDataUtility._value == 'justUs' -%}
                <p>{% trans %}This data are expected to be used only by us.{% endtrans %}</p>
              {%- elif neqDataUtility._value == 'sameField' -%}
                <p>{% trans %}Other researchers working in the same field of research could be interested in using this data.{% endtrans %}</p>
              {%- elif neqDataUtility._value == 'otherFields' -%}
                {%- set neqDataUtilityOtherFieldsHow = neqDataUtility.how._value -%}
                {% call macros.para() %}{% trans %}Researchers working in other fields of research could be interested in using this data.{% endtrans %} {% if neqDataUtilityOtherFieldsHow -%}{% trans value=(neqDataUtilityOtherFieldsHow|markdown) %}We think that other researchers can use this data as follows: {{ value }}{% endtrans %}{%- endif -%}{% endcall %}
              {%- endif -%}
            </li>
          {%- endfor -%}
          </ul>
        {%- endif -%}
      {% endcall %}
      </div>
    {%- endif -%}
  {%- endif -%}

  {# Existing datasets (reference datasets) #}
  {%- if preexisting._value is true -%}
    {%- set refDataItems = preexisting.referenceDatasets|selectattr('dataset._value', 'ne', none)|list -%}
    {%- set nrefDataItems = preexisting.nonReferenceDatasets|selectattr('dataset._value', 'ne', none)|list -%}
    {%- if (refDataItems|length + nrefDataItems|length) > 0 -%}
      <div>
        <h4>{% trans %}Re-used datasets{% endtrans %}</h4>
        {%- if refDataItems|length > 0 -%}
          <div>
          <p>{% trans %}We identified the following reference datasets considered for potential re-use:{% endtrans %}</p>
          <ul>
            {%- for item in refDataItems -%}
              {%- set refDataNameReply = item.dataset._value -%}
              {%- set refDataWhere = item.pid._value -%}
              {%- set refDataUsed = item.using -%}
              {%- set isNotUsed = refDataUsed._value is false -%}
              {%- set isUsed = refDataUsed._value is true -%}
              <li>
                {# identification #}
                <div><strong>{{ refDataNameReply }}</strong></div>
                {%- if refDataWhere -%}
                  <p>
                  {%- if refDataWhere.startswith("http://") or refDataWhere.startswith("https://") or refDataWhere.startswith("ftp://") %}
                    {% set link %}<a href="{{ refDataWhere }}" target="_blank">{{ refDataWhere }}</a>{% endset %}{% trans where=link %}It is available via: {{ where }}.{% endtrans %}
                  {%- else %}
                    {% trans where=refDataWhere %}It is available via: {{ where }}.{% endtrans %}
                  {%- endif %}
                  {% if isUsed %}
                    {% trans %}It is used in the project.{% endtrans %}
                  {%- elif isNotUsed %}
                    {% trans %}It was considered but will not be used in the project.{% endtrans %}
                  {%- endif -%}
                  </p>
                {%- endif -%}
                {# ref data - not used #}
                {%- if isNotUsed -%}
                  {%- set refDataUseNoWhy = refDataUsed.whyNot -%}
                  {%- if refDataUseNoWhy._value == 'missesData' -%}
                    <p>{% trans %}We decided not to use this reference dataset because it misses the data we need.{% endtrans %}</p>
                  {%- elif refDataUseNoWhy._value == 'missesAspects' -%}
                    <p>{% trans %}We decided not to use this reference dataset because it misses required aspects.{% endtrans %}</p>
                  {%- elif refDataUseNoWhy._value == 'insufficientQuality' -%}
                    <p>{% trans %}We decided not to use this reference dataset because it is not of sufficient quality.{% endtrans %}</p>
                  {%- elif refDataUseNoWhy._value == 'conditions' -%}
                    <p>{% trans %}We decided not to use this reference dataset because its conditions of use do not allow us to use it.{% endtrans %}</p>
                  {%- elif refDataUseNoWhy._value == 'other' -%}
                    {%- set reason = refDataUseNoWhy.reason._value -%}
                    {%- if reason -%}
                      {% call macros.para() %}{% trans value=(reason|markdown) %}We decided not to use this reference dataset because of: {{ value }}{% endtrans %}{% endcall %}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
                {# ref data - used #}
                {%- if isUsed -%}
                  {# owner #}
                  {%- set refDataOwner = refDataUsed.owner._value -%}
                  {%- if refDataOwner -%}
                    {% call macros.para() %}{% trans value=(refDataOwner|markdown) %}Owner of this dataset: {{ value }}{% endtrans %}{% endcall %}
                  {%- endif -%}
                  {# format #}
                  {%- set refDataFormat = refDataUsed.format._value -%}
                  {%- if refDataFormat == 'ok' -%}
                    <p>{% trans %}The dataset can be used in the provided format without any conversion needed.{% endtrans %}</p>
                  {%- elif refDataFormat == 'convert' -%}
                    <p>{% trans %}We will first need to convert the format before using it.{% endtrans %}</p>
                  {%- endif -%}
                  {# version #}
                  {%- set refDataVersioned = refDataUsed.isVersioned -%}
                  {%- if refDataVersioned._value is true -%}
                    {%- set refDataVersionedWhich = refDataVersioned.version._value -%}
                    {%- set refDataVersionedChange = refDataVersioned.updateVersion._value -%}
                    {%- if refDataVersionedWhich or refDataVersionedChange  %}
                      {% call macros.para() %}
                      {% if refDataVersionedWhich -%}
                        {% trans value=(refDataVersionedWhich|markdown) %}We will use the following version of this dataset: {{ value }}{% endtrans %}
                      {%- endif -%}
                      {%- if refDataVersionedChange == 'stayOld' %}
                        {% trans count=globals.projectsCount %}If a new version becomes available during the project, we will stay with the old version.{% pluralize %}If a new version becomes available during the projects, we will stay with the old version.{% endtrans %}
                      {%- elif refDataVersionedChange == 'newAnalyses' %}
                        {% trans count=globals.projectsCount %}If a new version becomes available during the project, new analyses will be done with the new version.{% pluralize %}If a new version becomes available during the projects, new analyses will be done with the new version.{% endtrans %}
                      {%- elif refDataVersionedChange == 'allAnalyses' %}
                        {% trans count=globals.projectsCount %}If a new version becomes available during the project, all analyses will be redone with the new version.{% pluralize %}If a new version becomes available during the projects, all analyses will be redone with the new version.{% endtrans %}
                      {%- endif -%}
                      {% endcall %}
                    {%- endif -%}
                  {%- endif -%}
                  {# reproduce #}
                  {%- set refDataReproduce = refDataUsed.reproduce._value -%}
                  {%- if refDataReproduce == 'keepsOldVersions' -%}
                    <p>{% trans %}The provider keeps old versions around so the same reference data will be available to reproduce our results.{% endtrans %}</p>
                  {%- elif refDataReproduce == 'keepCopy' -%}
                    <p>{% trans %}We will keep a copy of the dataset and make it available with our results for the reproducibility.{% endtrans %}</p>
                  {%- elif refDataReproduce == 'both' -%}
                    <p>{% trans %}The original dataset will be available both from the provider and from us together with our results for the reproducibility.{% endtrans %}</p>
                  {%- endif -%}
                  {# data use #}
                  {%- set dataUse = refDataUsed.usage._value -%}
                  {%- if dataUse -%}
                  {% call macros.para() %}{% trans value=(dataUse|markdown) %}We will use the dataset as follows: {{ value }}{% endtrans %}{% endcall %}
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          </div>
        {%- endif -%}
        {%- if nrefDataItems|length > 0 -%}
          <div>
          <p>{% trans %}We identified the following non-reference datasets considered for potential re-use:{% endtrans %}</p>
          <ul>
            {%- for item in nrefDataItems -%}
              {%- set nrefDataNameReply = item.dataset._value -%}
              {%- set nrefDataWhere = item.pid._value -%}
              {%- set nrefDataUsed = item.using -%}
              {%- set isNotUsed = nrefDataUsed._value is false -%}
              {%- set isUsed = nrefDataUsed._value is true -%}
              <li>
                {# identification #}
                <div><strong>{{ nrefDataNameReply }}</strong></div>
                {%- if nrefDataWhere -%}
                  <p>
                  {%- if nrefDataWhere.startswith("http://") or nrefDataWhere.startswith("https://") or nrefDataWhere.startswith("ftp://") %}
                    {% set link %}<a href="{{ nrefDataWhere }}" target="_blank">{{ nrefDataWhere }}</a>{% endset %}{% trans where=link %}It is available via: {{ where }}.{% endtrans %}
                  {%- else %}
                    {% trans where=nrefDataWhere %}It is available via: {{ where }}.{% endtrans %}
                  {%- endif %}
                  {% if isUsed %}
                    {% trans %}It is used in the project.{% endtrans %}
                  {%- elif isNotUsed %}
                    {% trans %}It was considered but will not be used in the project.{% endtrans %}
                  {%- endif -%}
                  </p>
                {%- endif -%}
                {# nref data - not used #}
                {%- if isNotUsed -%}
                  {%- set nrefDataUseNoWhy = nrefDataUsed.whyNot -%}
                  {%- if nrefDataUseNoWhy._value == 'missesData' -%}
                    <p>{% trans %}We decided not to use this non-reference dataset because it misses the data we need.{% endtrans %}</p>
                  {%- elif nrefDataUseNoWhy._value == 'missesAspects' -%}
                    <p>{% trans %}We decided not to use this non-reference dataset because it misses required aspects.{% endtrans %}</p>
                  {%- elif nrefDataUseNoWhy._value == 'insufficientQuality' -%}
                    <p>{% trans %}We decided not to use this non-reference dataset because it is not of sufficient quality.{% endtrans %}</p>
                  {%- elif nrefDataUseNoWhy._value == 'conditions' -%}
                    <p>{% trans %}We decided not to use this non-reference dataset because its conditions of use do not allow us to use it.{% endtrans %}</p>
                  {%- elif nrefDataUseNoWhy._value == 'other' -%}
                    {%- set reason = nrefDataUseNoWhy.reason._value -%}
                    {%- if reason -%}
                      {% call macros.para() %}{% trans value=(reason|markdown) %}We decided not to use this non-reference dataset because of: {{ value }}{% endtrans %}{% endcall %}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
                {# nref data - used #}
                {%- if isUsed -%}
                  {%- set ownerSentences = [] -%}
                  {# owner #}
                  {%- set nrefDataOwner = nrefDataUsed.owner._value -%}
                  {%- if nrefDataOwner -%}
                    {%- do ownerSentences.append(_("Owner of this dataset: %(owner)s", owner=nrefDataOwner|markdown)) -%}
                  {%- endif -%}
                  {# owners #}
                  {%- set nrefDataOwners = nrefDataUsed.rightsholderCollaborates -%}
                  {%- if nrefDataOwners._value == 'no' -%}
                    {%- if nrefDataOwners.needsRequest._value is true -%}
                      {%- do ownerSentences.append(_("We will need to request access to the dataset from its owners.")) -%}
                    {%- endif -%}
                  {%- elif nrefDataOwners._value == 'yes' -%}
                    {%- do ownerSentences.append(ngettext("The owners of the dataset will collaborate on this project.", "The owners of the dataset will collaborate on these projects.", globals.projectsCount)) -%}
                  {%- elif nrefDataOwners._value == 'we' -%}
                    {%- do ownerSentences.append(_("We are owners of the dataset.")) -%}
                  {%- endif -%}
                  {%- if ownerSentences|length > 0 -%}
                    {% call macros.para() %}{{ ownerSentences|join(" ") }}{% endcall %}
                  {%- endif -%}
                  {# format #}
                  {%- set nrefDataFormat = nrefDataUsed.format._value -%}
                  {%- if nrefDataFormat == 'ok' -%}
                    <p>{% trans %}The dataset can be used in the provided format without any conversion needed.{% endtrans %}</p>
                  {%- elif nrefDataFormat == 'convert' -%}
                    <p>{% trans %}We will first need to convert the format before using it.{% endtrans %}</p>
                  {%- endif -%}
                  {# data access #}
                  {%- set nrefDataAccess = nrefDataUsed.access._value -%}
                  {%- if nrefDataAccess is not none %}
                    <p>
                    {% if nrefDataAccess == 'haveCopy' -%}
                      {% trans %}We already have a copy of this dataset.{% endtrans %}
                    {%- elif nrefDataAccess == 'willGetCopy' -%}
                      {% trans %}We will download or get a copy.{% endtrans %}
                    {%- elif nrefDataAccess == 'online' -%}
                      {% trans %}We will use its online version without downloading it.{% endtrans %}
                    {%- endif -%}
                    </p>
                  {%- endif -%}
                  {# fixed #}
                  {%- set nrefDataFixed = nrefDataUsed.fixedOrUpdated._value -%}
                  {%- if nrefDataFixed == 'fixed' -%}
                    <p>{% trans %}It is a fixed dataset; changes will not influence the reproducibility of our results.{% endtrans %}</p>
                  {%- elif nrefDataFixed == 'mayChange' -%}
                    <p>{% trans %}The dataset may get updated in the future; therefore, we need to make a snapshot.{% endtrans %}</p>
                  {%- endif -%}
                  {# complete #}
                  {%- set nrefDataComplete = nrefDataUsed.useComplete._value -%}
                  {%- if nrefDataComplete == 'complete' -%}
                    <p>{% trans %}We will use the complete dataset.{% endtrans %}</p>
                  {%- elif nrefDataComplete == 'selection' -%}
                    <p>{% trans %}Only part of the dataset will be used; any filtering or selection will be well documented.{% endtrans %}</p>
                  {%- elif nrefDataComplete == 'availableSubset' -%}
                    <p>{% trans %}We will make sure the selected subset will be available together with our results.{% endtrans %}</p>
                  {%- endif -%}
                  {# data use #}
                  {%- set dataUse = nrefDataUsed.usage._value -%}
                  {%- if dataUse -%}
                  {% call macros.para() %}{% trans value=(dataUse|markdown) %}We will use the dataset as follows: {{ value }}{% endtrans %}{% endcall %}
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    {# data harmonization #}
    {%- set dataHarmo = preexisting.needHarmonisation -%}
    {%- if dataHarmo._value is false -%}
      <p>{% trans %}There is no need to harmonize different sources of existing data in our case.{% endtrans %}</p>
    {%- elif dataHarmo._value is true -%}
      <p>{% trans %}We will need to harmonize different sources of existing data.{% endtrans %}
      {%- if dataHarmo.available._value is true %}
        {% trans %}Our harmonization results will be made available to others.{% endtrans %}
      {%- endif %}
      </p>
    {%- endif -%}
    {# data computer readable #}
    {%- set dataCompRead = preexisting.needRemadeForComputer -%}
    {%- if dataCompRead._value is true -%}
    {%- set dataCompReadSentences = [] -%}
      {%- do dataCompReadSentences.append(_("We will be using data that needs to be (re-)made computer readable first.")) -%}
      {%- set dataCompReadOthers = dataCompRead.provideMetadata -%}
      {%- if dataCompReadOthers._value is true -%}
        {%- do dataCompReadSentences.append(_("We will provide machine readable, standardized metadata to others.")) -%}
        {%- set standards = [] -%}
        {%- for item in dataCompReadOthers.standards if item.standard._value is not none -%}
          {%- do standards.append(item.standard) -%}
        {%- endfor -%}
        {%- if standards|length > 0 %}
          {%- set standardLinks = [] -%}
          {%- for standardReply in standards %}
            {% do standardLinks.append(macros.fairsharing(standardReply)) %}
          {% endfor %}
          {%- do dataCompReadSentences.append(_("For that, we will use the following formats: %(formats)s.", formats=standardLinks|join(", "))) -%}
        {%- endif -%}
      {%- endif -%}
      {%- set dataCompReadItself = dataCompRead.available._value -%}
      {%- if dataCompReadItself == 'repository' %}
        {%- do dataCompReadSentences.append(_("The data itself will be made available in computer readable form to others through a standard repository.")) -%}
      {%- elif dataCompReadItself == 'other' %}
        {%- do dataCompReadSentences.append(_("The data itself will be made available in computer readable form to others.")) -%}
      {%- endif -%}
      {%- if dataCompReadSentences|length > 0 -%}
        <p>{{ dataCompReadSentences|join(" ") }}</p>
      {%- endif -%}
    {%- endif -%}
  {%- elif preexisting._value is false -%}
    <p>{% trans %}We will not be using any existing datasets.{% endtrans %}</p>
  {%- endif -%}

  {# Physical samples #}
  {%- set samples = x.creatingData.collectsPhysicalSample -%}
  {%- if samples._value is true -%}
    {%- set samplesPublic = samples.publicRepository -%}
    {%- set samplesLocal = samplesPublic.localRepository._value -%}
    {%- set samplesId = samples.howIdentified._value -%}
    {%- set samplesWhere = samples.whereStored._value -%}
    {%- set samplesCrossRef = samples.explicitCrossReferences._value -%}
    <h4>{% trans %}Physical samples{% endtrans %}</h4>
    <div>
    {% call macros.para() %}
      {% trans %}We will collect physical samples.{% endtrans %}
      {%- if samplesPublic._value is true %}
        {% trans %}The samples will be submitted to a public repository.{% endtrans %}
      {%- elif samplesPublic._value is false %}
        {% trans %}The samples do not need to be submitted to a public repository.{% endtrans %}
        {%- if samplesLocal is true %}
          {% trans %}They will be stored in a local repository such as a biobank.{% endtrans %}
        {%- elif samplesLocal is false %}
          {% trans %}They will not be stored in a local repository such as a biobank.{% endtrans %}
        {%- endif -%}
      {%- endif -%}
      {%- if samplesId == 'internal' %}
        {% trans %}The samples will only get an internal code.{% endtrans %}
      {%- elif samplesId == 'pid' %}
        {% trans %}The samples will receive a universally unique persistent identifier (PID).{% endtrans %}
      {%- endif -%}
      {%- if samplesCrossRef is true %}
        {% trans %}We will make explicit cross-references between the physical samples and our digital data.{% endtrans %}
      {%- elif samplesCrossRef is false %}
        {% trans %}We will not make explicit cross-references between the physical samples and our digital data.{% endtrans %}
      {%- endif -%}
      {%- if samplesWhere %}
        {% trans value=(samplesWhere|markdown) %}The physical samples will be stored as follows: {{ value }}{% endtrans %}
      {%- endif -%}
    {% endcall %}
    </div>
  {%- elif samples._value is false -%}
    <h4>{% trans %}Physical samples{% endtrans %}</h4>
    <p>{% trans %}We will not collect any physical samples.{% endtrans %}</p>
  {%- endif -%}

  {# Format/Type with volume #}
  {%- set formatsItems = formats -%}
  {%- set formatsList -%}
    {%- for formatItem in formatsItems -%}
        {%- set formatsIsStandard = formatItem.isStandard -%}
        {%- set formatsIsLTSuitable = formatItem.enablesSharingArchiving -%}
        {%- set formatsVolume = formatItem.volume -%}
        {%- set item -%}
          {# identification #}
          {%- set formatName = macros.fairsharing(formatItem.format)|trim -%}
          {%- if formatName -%}
            <div><strong>{{ formatName }}</strong></div>
          {%- endif -%}
          {%- set formatText -%}
            {# standard? #}
            {%- if formatsIsStandard._value is true %}
              {% trans %}It is a standardized format.{% endtrans %}
            {%- elif formatsIsStandard._value is false -%}
              {%- set formatsWhyNonStandard = formatsIsStandard.reason -%}
              {%- if formatsWhyNonStandard._value == 'noStandard' %}
                {% trans %}It is not a standardized format because there is no standardized format for this data type.{% endtrans %}
              {%- elif formatsWhyNonStandard._value == 'optimized' %}
                {% trans %}It is not a standardized format but it is optimized for processing speed and/or volume.{% endtrans %}
              {%- elif formatsWhyNonStandard._value == 'other' -%}
                {%- set formatsWhyNSAnotherReason = formatsWhyNonStandard.reason._value -%}
                {% trans %}It is not a standardized format.{% endtrans %}
                {%- if formatsWhyNSAnotherReason %}
                  {{ formatsWhyNSAnotherReason|capitalize|trim|dot }}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
            {# long-term suitable? #}
            {%- if formatsIsLTSuitable._value is true %}
              {% trans %}This is a suitable format for long-term archiving.{% endtrans %}
            {%- elif formatsIsLTSuitable._value is false -%}
              {%- set formatsConvertLTSuitable = formatsIsLTSuitable.convert._value -%}
              {%- if formatsConvertLTSuitable is true %}
                {% trans %}This is not a suitable format for long-term archiving; however, we plan to convert it to a suitable format before the end of the project.{% endtrans %}
              {%- elif formatsConvertLTSuitable is false %}
                {% trans %}We are aware that this is not a suitable format for long-term archiving.{% endtrans %}
              {%- endif -%}
            {%- endif -%}
            {# volume #}
            {%- if formatsVolume._value == 'small' %}
              {% trans %}We will have only a small amount of data stored in this format.{% endtrans %}
            {%- elif formatsVolume._value == 'gigabytes' -%}
              {%- set formatsVolumeTotalGB = formatsVolume.valueGb._value -%}
              {%- if formatsVolumeTotalGB not in [none, ''] %}
                {% trans size=formatsVolumeTotalGB %}We expect to have {{ size }} GB of data in this format.{% endtrans %}
              {%- endif -%}
            {%- elif formatsVolume._value == 'files' -%}
              {%- set formatsVolumeFiles = formatsVolume.number._value -%}
              {%- set formatsVolumeFileGB = formatsVolume.averageSizeGb._value -%}
              {%- if formatsVolumeFiles not in [none, ''] and formatsVolumeFileGB not in [none, ''] %}
                {% trans files=formatsVolumeFiles, size=formatsVolumeFileGB, value=((formatsVolumeFiles|int * formatsVolumeFileGB|float)|round(2)) %}We expect to have {{ files }} files of average size {{ size }} GB (i.e. approximately {{ value }} GB in total).{% endtrans %}
              {%- endif -%}
            {%- endif -%}
          {%- endset -%}
          {%- if formatText|trim -%}
            <p>{{ formatText|trim }}</p>
          {%- endif -%}
        {%- endset -%}
        {%- if item|trim %}
        <li>{{ item }}</li>
        {%- endif -%}
    {%- endfor -%}
  {%- endset -%}
  {%- if formatsList|trim -%}
    <h4>{% trans %}Data formats and types{% endtrans %}</h4>
    <div>
    <p>{% trans %}We will be using the following data formats and types:{% endtrans %}</p>
    <ul>{{ formatsList }}</ul>
    </div>
  {%- endif -%}

  {# Storage and file conventions #}
  {%- if storageConv._value == 'explore' -%}
    {%- set storageSpace = storageConv.storageNeeds -%}
    {%- set storageConvFSys = storageConv.filesFolders -%}
    {%- set storageConvObjStore = storageConv.objectStore -%}
    {%- set storageConvRelDb = storageConv.databaseSystem -%}
    {%- if storageSpace._value is not none or storageConvFSys._value is not none or storageConvObjStore._value is not none or storageConvRelDb._value is not none -%}
      <h4>{% trans %}Data storage and file conventions{% endtrans %}</h4>
      {# Storage space #}
      {%- if storageSpace._value == 'little' -%}
        <p>{% trans count=globals.projectsCount %}The project will require so little storage space for all data and software (including temporary storage) that it is not a problem.{% pluralize %}The projects will require so little storage space for all data and software (including temporary storage) that it is not a problem.{% endtrans %}</p>
      {%- elif storageSpace._value == 'specify' -%}
        {%- set size = storageSpace.gigabytes._value -%}
        {%- if size not in [none, ''] -%}
        <p>{% trans count=globals.projectsCount, size=size %}We estimate the storage space that the project will require for all data and software (including temporary storage) to {{ size }} gigabytes.{% pluralize %}We estimate the storage space that the projects will require for all data and software (including temporary storage) to {{ size }} gigabytes.{% endtrans %}</p>
        {%- endif -%}
      {%- endif -%}
      {# File System #}
      {%- if storageConvFSys._value is false -%}
        <p>{% trans %}We will not use a filesystem with files and folders.{% endtrans %}</p>
      {%- elif storageConvFSys._value is true -%}
        {# Folder types #}
        {%- set subjectFolders = storageConvFSys.folderSample._value is true -%}
        {%- set analysisFolders = storageConvFSys.folderAnalysis._value is true -%}
        {%- set workflowStepFolders = storageConvFSys.folderWorkflowStep._value is true -%}
        {%- set folders = [subjectFolders, analysisFolders, workflowStepFolders] -%}
        {% call macros.para() %}
        {%- if folders|any -%}
          {% trans %}We will use a filesystem with files and folders with the following folder conventions:{% endtrans %}
          <ul>
            {%- if subjectFolders -%}
              {%- set scFSysSubjFoldersConvs = storageConvFSys.folderSample.convention._value -%}
              <li>
                {% trans %}There will be a <strong>folder for each sample/subject</strong>.{% endtrans %}
                {% if scFSysSubjFoldersConvs %}
                  {% trans value=(scFSysSubjFoldersConvs|trim|dot) %}Each of those will use the following conventions: {{ value }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
            {%- if analysisFolders -%}
              {%- set scFSysAnalysisFoldersConvs = storageConvFSys.folderAnalysis.convention._value -%}
              <li>
                {% trans %}There will be a <strong>(sub)folder for each (repeated) analysis</strong>.{% endtrans %}
                {% if scFSysAnalysisFoldersConvs %}
                  {% trans value=(scFSysAnalysisFoldersConvs|trim|dot) %}Each of those will use the following conventions: {{ value }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
            {%- if workflowStepFolders -%}
              {%- set scFSysWorkflowStepFoldersConvs = storageConvFSys.folderWorkflowStep.convention._value -%}
              <li>
                {% trans %}There will be a <strong>(sub)folder for each step in the analysis workflow</strong>.{% endtrans %}
                {% if scFSysWorkflowStepFoldersConvs %}
                  {% trans value=(scFSysWorkflowStepFoldersConvs|trim|dot) %}Each of those will use the following conventions: {{ value }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
          </ul>
        {%- else -%}
          {% trans %}We will use a filesystem with files and folders.{% endtrans %}
        {%- endif -%}
        {# Versioning #}
        {%- if storageConvFSys.fileVersioningDocs._value is true %}
          {% trans %}We document how we manage file versioning for files and folders.{% endtrans %}
        {%- endif -%}
        {# Agreements about file names #}
        {%- set scFSysAppointments = storageConvFSys.fileNaming._value -%}
        {%- if scFSysAppointments %}
          {%- if folders|any %}
          {% trans agreements=(scFSysAppointments|trim|dot) %}Moreover, we have made the following agreements about naming the files: {{ agreements }}{% endtrans %}
          {%- else %}
          {% trans agreements=(scFSysAppointments|trim|dot) %}We have made the following agreements about naming the files: {{ agreements }}{% endtrans %}
          {%- endif -%}
        {%- endif -%}
        {% endcall %}
      {%- endif -%}
      {# Object Store #}
      {%- if storageConvObjStore._value is false -%}
        <p>{% trans %}We will not be storing data in an "object store" system.{% endtrans %}</p>
      {%- elif storageConvObjStore._value is true -%}
        {%- set scObjStoreNaming = storageConvObjStore.convention._value -%}
        {%- if scObjStoreNaming -%}
          <p>{% trans value=(scObjStoreNaming|trim|dot) %}We will be storing data in an "object store" system using the following naming conventions for objects in the store: {{ value }}{% endtrans %}</p>
        {%- else -%}
          <p>{% trans %}We will be storing data in an "object store" system.{% endtrans %}</p>
        {%- endif -%}
      {%- endif -%}
      {# Database #}
      {%- if storageConvRelDb._value is false -%}
        <p>{% trans %}We will not use a database system to store project data.{% endtrans %}</p>
      {%- elif storageConvRelDb._value is true -%}
        <p>
        {% trans %}We will use a database system to store project data.{% endtrans %}
        {%- set scRelDbHandleChanges = storageConvRelDb.changeHandling._value -%}
        {%- if scRelDbHandleChanges == 'readOnly' %}
          {% trans %}Data in the database will be read-only.{% endtrans %}
        {%- elif scRelDbHandleChanges == 'crud' %}
          {% trans %}We will be allowing Create, Update and Delete operations for data in the database.{% endtrans %}
        {%- elif scRelDbHandleChanges == 'expireAdd' %}
          {% trans %}Modifications will be made by <em>Expiring</em> the existing data and <em>Adding</em> updated data.{% endtrans %}
        {%- endif %}
        </p>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  </div>
</div>
