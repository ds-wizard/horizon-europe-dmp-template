{#- data -#}
{%- set producedDataItems = x.preservingData.producedDatasets -%}
{%- set metadata = x.creatingData.collectingMetadata -%}
{%- set fileOrganization = x.creatingData.fileOrganization -%}
<div id="q-findable" class="question">
  <div class="answer">
    {# Produced datasets #}
    {%- if producedDataItems|length > 0 -%}
      <ul>
      {%- for dataset in producedDataItems -%}
        {%- set producedDataName = dataset.dataset._value -%}
        <li>
          <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong>
          {# If will be published #}
          {%- set published = dataset.published -%}
          {% if published._value is false %}
            {% trans %}(not published){% endtrans %}
          {% elif published._value is true %}
            {% trans %}(will be published){% endtrans %}
          {# Identifiers #}
          {% set identifiersList -%}
          {%- for identifier in dataset.identifiers if identifier.identifier._value -%}
            {%- set identifierValue = identifier.identifier._value -%}
            {%- set identifierType = macros.fairsharingLabel(identifier.type)|trim -%}
            {%- if identifierType|upper == 'DOI' -%}
              <li>{% trans %}DOI:{% endtrans %} <strong><a href="https://doi.org/{{ identifierValue }}" target="_blank">{{ identifierValue }}</a></strong></li>
            {%- elif identifierValue.startswith('http://') or identifierValue.startswith('https://') -%}
              <li>{{ identifierType ~ ': ' if identifierType }}<strong><a href="{{ identifierValue }}" target="_blank">{{ identifierValue }}</a></strong></li>
            {%- else -%}
              <li>{{ identifierType ~ ': ' if identifierType }}<strong>{{ identifierValue }}</strong></li>
            {%- endif -%}
          {%- endfor -%}
          {%- endset -%}
          {%- if identifiersList|trim %}
          <br>{% trans %}The dataset has the following identifiers:{% endtrans %}
          <ul>{{ identifiersList }}</ul>
          {%- endif %}
          {# Distributions #}
          {% set distrosList -%}
            {%- for distro in published.distributions -%}
              {%- set repository = distro.repository -%}
              {%- set distroRepositoryKind = repository._value -%}
              {%- if distroRepositoryKind -%}
                <li>
                  {%- if distroRepositoryKind == 'domainSpecific' %}
                    <em>{% trans %}Domain-specific repository{% endtrans %}</em>
                    {%- if repository.repository._value is not none -%}
                      : {{ macros.fairsharing(repository.repository) }}.
                    {%- else -%}.
                    {% endif -%}
                    {# Contact the repository #}
                    {%- set contactBefore = repository.contactBefore -%}
                    {%- if contactBefore._value == 'no' %}
                      {% trans %}We don't need to contact the repository because it is a routine for us.{% endtrans %}
                    {%- elif contactBefore._value == 'done' %}
                      {% trans %}We have already contacted the repository.{% endtrans %}
                    {%- elif contactBefore._value == 'will' %}
                      {% trans %}We are going to contact the repository.{% endtrans %}
                    {%- elif contactBefore._value == 'other' -%}
                      {%- set domainSpecificRepoContactBeforeOther = contactBefore.other._value %}
                      {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ domainSpecificRepoContactBeforeOther|markdown if domainSpecificRepoContactBeforeOther else ".") %}We have made other arrangements{{ value }}{% endtrans %}
                    {%- endif -%}
                  {%- elif distroRepositoryKind == 'generalPurpose' %}
                    <em>{% trans %}General-purpose repository{% endtrans %}</em>
                    {%- if repository.repository._value is not none -%}
                      : {{ macros.fairsharing(repository.repository) }}.
                    {%- else -%}.
                    {% endif -%}
                  {%- elif distroRepositoryKind == 'national' %}
                    {% trans %}<em>Our national repository</em>.{% endtrans %}
                  {%- elif distroRepositoryKind == 'institutional' %}
                    {% trans %}<em>Our institutional repository</em>.{% endtrans %}
                  {%- elif distroRepositoryKind == 'specialPurpose' %}
                    {% trans count=globals.projectsCount %}<em>Special-purpose repository for the project</em>.{% pluralize %}<em>Special-purpose repository for the projects</em>.{% endtrans %}
                    {# Long-term support #}
                    {%- if repository.longTermSupport._value is true %}
                      {% trans %}We will be able to support this repository for a sufficiently long time.{% endtrans %}
                    {%- endif -%}
                    {# Service level #}
                    {%- set specialRepoServiceLevel = repository.serviceLevel._value -%}
                    {%- if specialRepoServiceLevel == 'onlyDownload' %}
                      {% trans %}The repository will provide download-only service.{% endtrans %}
                    {%- elif specialRepoServiceLevel == 'simpleSearch' %}
                      {% trans %}The repository will provide a search and simple access interface.{% endtrans %}
                    {%- elif specialRepoServiceLevel == 'advanced' %}
                      {% trans %}The repository will provide an advanced processing service.{% endtrans %}
                    {%- endif -%}
                  {%- endif -%}
                  {# Assigned identifier #}
                  {%- set distroPid = distro.assignPid -%}
                  {%- if distroPid._value is true -%}
                    {%- set distroPidWho = distroPid.assigner._value -%}
                    {%- set pidSentences = [] %}
                    {%- if distroPidWho == 'project' -%}
                      {%- do pidSentences.append(_("A persistent identifier will be assigned by a project data steward or principal investigator.")) -%}
                    {%- elif distroPidWho == 'institution' -%}
                      {%- do pidSentences.append(_("A persistent identifier will be assigned by an institutional data steward.")) -%}
                    {%- elif distroPidWho == 'repository' -%}
                      {%- do pidSentences.append(_("A persistent identifier will be assigned by the repository.")) -%}
                    {%- else -%}
                      {%- do pidSentences.append(_("A persistent identifier will be assigned.")) -%}
                    {%- endif -%}
                    {%- if distroPid.pidResolvable._value is true %}
                      {%- do pidSentences.append(_("The repository will make sure that the persistent identifier can be resolved to a digital object.")) -%}
                    {%- endif -%}
                    {%- if pidSentences|length > 0 %}
                      <br>{{ pidSentences|join(" ") }}
                    {%- endif -%}
                  {%- endif %}
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endset -%}
          {%- if distrosList|trim -%}
            <br>{% trans %}We will distribute the dataset using:{% endtrans %}
            <ul>{{ distrosList }}</ul>
          {%- endif -%}

          {# Version #}
          {%- set versions = published.differentVersions %}
          {%- if versions._value is false -%}
            <br>{% trans %}There won't be different versions of this data over time.{% endtrans %}
          {% elif versions._value is true -%}
            {%- set versionsRecognizeItems = versions.recognition|map(attribute='_value')|list -%}
            {%- set versionsRecognize = [] -%}

            {%- if 'date' in versionsRecognizeItems -%}
              {%- do versionsRecognize.append(_("dated")) -%}
            {%- endif -%}
            {%- if 'number' in versionsRecognizeItems -%}
              {%- do versionsRecognize.append(_("numbered")) -%}
            {%- endif -%}
            {%- if versionsRecognize|length == 0 %}
            <br>{% trans %}There will be different versions of this data over time.{% endtrans %}
            {%- else %}
            {#- TRANSLATORS: %(kinds)s is "dated", "numbered", or both -#}
            <br>{% trans kinds=macros.joinAnd(versionsRecognize) %}There will be different versions of this data over time; the versions will be {{ kinds }}.{% endtrans %}
            {%- endif -%}
          {%- endif -%}

          {# Catalogue #}
          {%- set publishedDataCatalogue = published.addingCatalogReference._value -%}
          {%- if publishedDataCatalogue == 'primeSource' -%}
            <br>{% trans %}We will not be adding a reference to any data catalogue because the data will be stored in a repository that is the prime source of data for re-use in the field.{% endtrans %}
          {%- elif publishedDataCatalogue == 'yes' -%}
            <br>{% trans %}We will be adding a reference to the published data to at least one data catalogue.{% endtrans %}
          {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
      </ul>
    {%- endif -%}

    {# Metadata #}
    {%- if metadata._value == 'explore' -%}
      {# MIA #}
      {%- set metadataMia = metadata.miaStandardsExist -%}
      {%- if metadataMia._value is false -%}
        {%- if metadataMia.idea._value is true -%}
          <p>{% trans %}There are no 'Minimal Metadata About ...' (MIA...) standards for our experiments. However, we have a good idea of what metadata is needed to make it possible for others to read and interpret our data in the future.{% endtrans %}</p>
        {%- endif -%}
      {%- elif metadataMia._value is true -%}
        {%- set metadataStandardReplies = [] -%}
        {%- for metadataMiaItem in metadataMia.standards if metadataMiaItem.standard._value is not none -%}
          {%- do metadataStandardReplies.append(metadataMiaItem.standard) -%}
        {%- endfor -%}
        {%- if metadataStandardReplies|length > 0 -%}
          <p>{% trans %}There are the following 'Minimal Metadata About ...' (MIA...) standards for our experiments:{% endtrans %}</p>
          <ul>
          {%- for metadataStandardReply in metadataStandardReplies -%}
            <li>{{ macros.fairsharing(metadataStandardReply) }}</li>
          {%- endfor -%}
          </ul>
        {%- else -%}
          <p>{% trans %}There are 'Minimal Metadata About ...' (MIA...) standards for our experiments.{% endtrans %}</p>
        {%- endif -%}
      {%- endif -%}
      {# Metadata #}
      {# Good provenance (lab notebooks) #}
      {%- set provenance = metadata.howProvenance -%}
      {%- if provenance._value == 'labNotebooks' -%}
        <p>{% trans %}We will use lab notebooks to make sure that there is good provenance of the data analysis.{% endtrans %}</p>
      {%- elif provenance._value == 'eln' -%}
        <p>{% trans %}We will use an electronic lab notebook to make sure that there is good provenance of the data analysis.{% endtrans %}</p>
      {%- elif provenance._value == 'workflow' -%}
        <p>{% trans %}Our computing workflow system keeps provenance information about the data analysis.{% endtrans %}</p>
      {%- elif provenance._value == 'other' -%}
        {%- set provenanceOther = provenance.other._value -%}
        {% call macros.para() %}{% trans value=(": " ~ provenanceOther|markdown if provenanceOther else ".") %}We will use a solution other than (electronic) lab notebooks to make sure that there is good provenance of the data analysis{{ value }}{% endtrans %}{% endcall %}
      {%- endif -%}

      {# Metadata standards #}
      {%- set metadataSentences = [] -%}
      {%- set metadataStandards = [] -%}
      {%- for item in metadata.standards if item.standard._value is not none -%}
        {%- do metadataStandards.append(macros.fairsharing(item.standard)) -%}
      {%- endfor -%}
      {%- if metadataStandards|length > 0 -%}
        {#- TRANSLATORS: %(standards)s is an enumeration of metadata standards, e.g. "Dublin Core, DataCite, and DDI" -#}
        {%- do metadataSentences.append(ngettext("We will be documenting the data with the %(standards)s metadata standard.", "We will be documenting the data with the %(standards)s metadata standards.", metadataStandards|length, standards=macros.joinAnd(metadataStandards))) -%}
      {%- endif -%}

      {# Provenance standards #}
      {%- set provenanceStandards = [] -%}
      {%- for item in metadata.standardsProvenance if item.standardProvenance._value is not none -%}
        {%- do provenanceStandards.append(macros.fairsharing(item.standardProvenance)) -%}
      {%- endfor -%}
      {%- if provenanceStandards|length > 0 -%}
        {#- TRANSLATORS: %(standards)s is an enumeration of provenance standards, e.g. "W3C PROV and PROV-O" -#}
        {%- do metadataSentences.append(_("The provenance will be captured using %(standards)s.", standards=macros.joinAnd(provenanceStandards))) -%}
      {%- endif -%}

      {%- if metadataSentences|length > 0 -%}
        <p>{{ metadataSentences|join(" ") }}</p>
      {%- endif -%}

      {# filenames #}
      {%- if fileOrganization._value == 'explore' -%}
        {%- set sentences = [] -%}
        {%- set metadataSop = fileOrganization.appointments -%}
        {%- if metadataSop._value is true -%}
          {%- do sentences.append(_("We made a SOP (Standard Operating Procedure) for file naming.")) -%}
          {%- set metadataSopDescribe = metadataSop.naming._value -%}
          {%- if metadataSopDescribe -%}
            {%- do sentences.append(metadataSopDescribe|markdown) -%}
          {%- endif -%}
        {%- endif -%}
        {%- if fileOrganization.keepRelationships._value is true -%}
          {%- do sentences.append(_("We will be keeping the relationships between data clear in the file names.")) -%}
        {%- endif -%}
        {%- if fileOrganization.embedFilenameMetadata._value is true -%}
          {%- do sentences.append(_("All the metadata in the file names will also be available in the proper metadata.")) -%}
        {%- endif -%}
        {%- if sentences|length > 0 -%}
          {% call macros.para() %}{{ sentences|join(' ') }}{% endcall %}
        {%- endif -%}
        {# persistent identifiers within the project #}
        {%- if fileOrganization.usePids._value is true -%}
          <p>{% trans %}We will use persistent identifiers to refer to data within the project.{% endtrans %}</p>
        {%- elif fileOrganization.usePids._value is false -%}
          <p>{% trans %}We will not use persistent identifiers to refer to data within the project.{% endtrans %}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
