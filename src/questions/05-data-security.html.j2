{#- data -#}
{%- set dataRisks = x.processingData.dataLossLeakVandalismRisks -%}
{%- set carryHome = dataRisks.membersCarryData -%}
{%- set personalData = dataRisks.personalDataProtection -%}
{%- set pseudonymization = personalData.pseudonymization -%}
{%- set workspace = x.processingData.sharedWorkingSpace -%}
{%- set coldStorage = x.preservingData.coldStorageDuringProject -%}
{%- set coldProtect = coldStorage.needsProtection -%}
{%- set collab = x.creatingData.withDifferentGroups -%}
<div id="q-data-security" class="question">
  <div class="answer">
    {# Basic risks #}
    {%- if dataRisks._value == 'explore' -%}
      {%- set homeEncrypted = carryHome.encrypted._value is true -%}
      {%- set homePassword = carryHome.passwordProtected._value is true -%}
      {%- set storeLab = dataRisks.storeLabExternalHardDrives._value is false -%}

      {%- if storeLab or (carryHome._value is false) or (carryHome._value is true and (homeEncrypted or homePassword)) or (dataRisks.certifiedDataCentres._value is true) or (dataRisks.httpsWebServices._value is true) or (dataRisks.membersInstructedAboutRisks._value is true) %}
        <p>
          {%- if storeLab %}
            {% trans %}Project members will not store data or software on computers in the lab or external hard drives connected to those computers.{% endtrans %}
          {% endif -%}
          {% if carryHome._value is false %}
            {%- if storeLab -%}{% trans %}They{% endtrans %}{%- else -%}{% trans %}Project members{% endtrans %}{%- endif %} {% trans %}will not carry data with them (e.g. on laptops, USB sticks, or other external media).{% endtrans %}
          {% elif homeEncrypted and homePassword %}
            {%- if storeLab -%}{% trans %}They{% endtrans %}{%- else -%}{% trans %}Project members{% endtrans %}{%- endif %} {% trans %}can carry data with them on encrypted data carriers and password-protected laptops.{% endtrans %}
          {% elif homeEncrypted %}
            {%- if storeLab -%}{% trans %}They{% endtrans %}{%- else -%}{% trans %}Project members{% endtrans %}{%- endif %} {% trans %}can carry data with them on encrypted data carriers.{% endtrans %}
          {% elif homePassword %}
            {%- if storeLab -%}{% trans %}They{% endtrans %}{%- else -%}{% trans %}Project members{% endtrans %}{%- endif %} {% trans %}can carry data with them on password-protected laptops.{% endtrans %}
          {% endif -%}
          {%- if dataRisks.certifiedDataCentres._value is true %}
            {% trans %}All data centers where project data is stored hold appropriate certifications.{% endtrans %}
          {% endif -%}
          {%- if dataRisks.httpsWebServices._value is true %}
            {% trans %}All project web services are accessible via secure HTTP (https://...).{% endtrans %}
          {% endif -%}
          {%- if dataRisks.membersInstructedAboutRisks._value is true %}
            {% trans count=globals.projectsCount %}Project members have been instructed about both generic and specific risks to the project.{% pluralize %}Project members have been instructed about both generic and specific risks to the projects.{% endtrans %}
          {% endif -%}
        </p>
      {%- endif -%}
      {# Information loss, leak, and vandalism #}
      {# Define mapping of answer codes to qualitative levels #}
      {%- set risk_levels = {
        'negligible': 'small',
        'acceptablyLow': 'low',
        'needWork': 'will'
      } -%}

      {# Extract selected levels for each type #}
      {%- set selected = {
        'loss': risk_levels[dataRisks.considerLossImpact._value],
        'leak': risk_levels[dataRisks.considerLeakImpact._value],
        'vandalism': risk_levels[dataRisks.considerVandalismImpact._value]
      } -%}

      {%- set small = [] -%}
      {%- set low = [] -%}
      {%- set will = [] -%}

      {# simple grouping in one pass #}
      {%- for key, level in selected.items() -%}
        {%- if level == 'small' -%}
          {%- do small.append(key) -%}
        {%- elif level == 'low' -%}
          {%- do low.append(key) -%}
        {%- elif level == 'will' -%}
          {%- do will.append(key) -%}
        {%- endif -%}
      {%- endfor -%}

      {#- TRANSLATORS: kinds of risk in "The risk of information loss, leak, and vandalism ..." -#}
      {%- set riskNames = {'loss': _('loss'), 'leak': _('leak'), 'vandalism': _('vandalism')} -%}
      {%- set sentences = [] -%}
      {%- if small|length > 0 -%}
        {%- do sentences.append(_("The possible impact of information %(risks)s is small.", risks=macros.joinAnd(riskNames|extract(small)))) -%}
      {%- endif -%}
      {%- if low|length > 0 -%}
        {%- do sentences.append(_("The risk of information %(risks)s is acceptably low.", risks=macros.joinAnd(riskNames|extract(low)))) -%}
      {%- endif -%}
      {%- if will|length > 0 -%}
        {%- do sentences.append(_("We will mitigate the risk of information %(risks)s.", risks=macros.joinAnd(riskNames|extract(will)))) -%}
      {%- endif -%}
      {%- if sentences|length > 0 -%}
        <p>{{ sentences|join(' ') }}</p>
      {%- endif -%}

      {# Personal data #}
      {%- if personalData._value == 'noPersonalData' -%}
        <p>{% trans %}We are not using any personal information.{% endtrans %}</p>
      {%- elif personalData._value == 'pseudonymizedOnly' -%}
        {% call macros.para() %}
          {% trans %}All personal information will be processed in pseudonymized form only.{% endtrans %}
          {%- if pseudonymization._value == 'insideProjectLimitedPeopleKey' %}
            {% trans %}We pseudonymize inside the project; only a limited number of people can access the keys.{% endtrans %}
          {%- elif pseudonymization._value == 'independentParty' %}
            {% trans %}Pseudonymization is handled by an independent party in order to allow data coupling.{% endtrans %}
          {%- elif pseudonymization._value == 'other' -%}
            {%- set risksPseudonymizationAnother = pseudonymization.other._value %}
            {# TRANSLATORS: %(value)s is ": " followed by the answer, or "." (or nothing in a list item) #}{% trans value=(": " ~ risksPseudonymizationAnother|markdown if risksPseudonymizationAnother else ".") %}We have a specific way of pseudonymization{{ value }}{% endtrans %}
          {%- endif -%}
        {% endcall %}
      {%- elif personalData._value == 'anonymouslyCollected' -%}
        <p>{% trans %}All personal data will be collected anonymously.{% endtrans %}</p>
      {%- elif personalData._value == 'anonymisedEarly' -%}
        <p>{% trans %}All personal data will be anonymized as early as possible.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}

    {# Access control in shared workspace #}
    {%- if workspace._value is true -%}
      {%- set accessControl = workspace.accessControl._value -%}
      {%- if accessControl == 'onlyMembersReadWrite' -%}
        <p>{% trans %}Only project members have read/write access to the data.{% endtrans %}</p>
      {%- elif accessControl == 'instituteReadMembersWrite' -%}
        <p>{% trans %}Anyone in the institute has read access to the data; all project members have read/write access.{% endtrans %}</p>
      {%- elif accessControl == 'membersReadSelectedWrite' -%}
        <p>{% trans %}Only project members will have read access; only selected project members will be able to write data.{% endtrans %}</p>
      {%- elif accessControl == 'instituteReadMembersRequest' -%}
        <p>{% trans %}Anyone in the institute can read data; only project members can request write access.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}

    {# Cold storage #}
    {%- if coldStorage._value is true -%}
      {%- set coldSentences = [] -%}
      {%- if coldStorage.remoteLocation._value is true -%}
        {%- do coldSentences.append(_("The archive will be stored in a remote location to protect the data against disasters.")) -%}
      {%- endif -%}

      {%- if coldProtect._value is true -%}
        {%- do coldSentences.append(_("The archive needs to be protected against loss or theft.")) -%}

        {%- if coldProtect.encryption._value == 'notNeeded' -%}
          {%- do coldSentences.append(_("The data does not need protection in terms of encryption.")) -%}
        {%- elif coldProtect.encryption._value == 'yes' -%}
          {%- if coldProtect.encryption.keyAccessClear._value is true -%}
            {%- do coldSentences.append(_("It will be encrypted and it is clear who has access to the key (also in case of a required data restore).")) -%}
          {%- else -%}
            {%- do coldSentences.append(_("It will be encrypted.")) -%}
          {%- endif -%}
        {%- endif -%}
        {%- if coldProtect.physicalAccessClear._value is true -%}
          {%- do coldSentences.append(_("It is clear who has physical access to the archives.")) -%}
        {%- endif -%}
      {%- endif -%}

      {%- if coldSentences|length > 0 -%}
        <p>{{ coldSentences|join(" ") }}</p>
      {%- endif -%}
    {%- endif -%}

    {# Collaboration agreement for data access #}
    {%- if collab._value is false -%}
      <p>{% trans %}We are not running the project in a collaboration between different groups or institutes. Therefore, no collaboration agreement related to data access is needed.{% endtrans %}</p>
    {%- elif collab._value is true -%}
      {%- if collab.hasAgreement._value is false -%}
       <p>{% trans %}We are running the project in a collaboration between different groups and institutes. However, there is no collaboration agreement in the project that describes who can have access to what data.{% endtrans %}</p>
      {%- elif collab.hasAgreement._value is true -%}
        <p>{% trans %}We are running the project in a collaboration between different groups and institutes. A collaboration agreement that describes who can have access to what data in the project is in place.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
