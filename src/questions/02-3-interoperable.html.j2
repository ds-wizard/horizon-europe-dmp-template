{#- data -#}
{%- set formats = x.creatingData.usesDataFormats -%}
{%- set vocabularies = x.creatingData.usesVocabularies -%}
{%- set newTypes = x.creatingData.usesNewDataTypes -%}
{%- set producedDatasets = x.preservingData.producedDatasets -%}
<div id="q-interoperable" class="question">
  <div class="answer">
  {# Format/Type with volume #}
  {%- set formatsList -%}
      {%- for dataFormat in formats -%}
        {%- set isStandard = dataFormat.isStandard -%}
        {%- set item -%}
          {# identification #}
          {%- set formatName = macros.fairsharing(dataFormat.format)|trim -%}
          {%- if formatName -%}
            <div><strong>{{ formatName }}</strong></div>
          {%- endif -%}
          {%- set formatText -%}
            {# standard? #}
            {%- if isStandard._value is true %}
              {% trans %}It is a standardized format.{% endtrans %}
            {%- elif isStandard._value is false -%}
              {%- set whyNonStandard = isStandard.reason -%}
              {%- if whyNonStandard._value == 'noStandard' %}
                {% trans %}It is not a standardized format because there is no standardized format for this data type.{% endtrans %}
              {%- elif whyNonStandard._value == 'optimized' %}
                {% trans %}It is not a standardized format but it is optimized for processing speed and/or volume.{% endtrans %}
              {%- elif whyNonStandard._value == 'other' -%}
                {%- set formatsWhyNSAnotherReason = whyNonStandard.reason._value -%}
                {% trans %}It is not a standardized format.{% endtrans %}
                {%- if formatsWhyNSAnotherReason %}
                  {{ formatsWhyNSAnotherReason|capitalize|trim|dot }}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endset -%}
          {%- if formatText|trim -%}
            <p>{{ formatText|trim }}</p>
          {%- endif -%}
          {# completely described? #}
          {%- if dataFormat.isDescribed._value is true -%}
            <p>{% trans %}The format is completely described.{% endtrans %}</p>
          {%- elif dataFormat.isDescribed._value is false -%}
            <p>{% trans %}The format is not completely described.{% endtrans %}</p>
          {%- endif -%}
        {%- endset -%}
        {%- if item|trim %}
        <li>{{ item }}</li>
        {%- endif -%}
      {%- endfor -%}
  {%- endset -%}
  {%- if formatsList|trim -%}
    <div>
    <p>{% trans %}We will be using the following data formats and types:{% endtrans %}</p>
    <ul>{{ formatsList }}</ul>
    </div>
  {%- endif -%}

  {# Standards used #}
  {%- set whatUsingList -%}
      {%- for standard in vocabularies -%}
        {%- set whatUsingUrl = standard.url._value -%}
        {%- set item -%}
          {%- set whatUsingName = macros.fairsharing(standard.name)|trim -%}
          {%- if whatUsingName %}
          <div><strong>{{ whatUsingName }}</strong></div>
          {%- endif %}
          {% if whatUsingUrl %}({{ whatUsingUrl }}){% endif %}
        {%- endset -%}
        {%- if item|trim %}
        <li>{{ item }}</li>
        {%- endif -%}
      {%- endfor -%}
  {%- endset -%}
  {%- if whatUsingList|trim -%}
    <div>
    <p>{% trans %}We will be using the following standards (encodings, terminologies, vocabularies, ontologies):{% endtrans %}</p>
    <ul>{{ whatUsingList }}</ul>
    </div>
  {%- endif -%}

  {# New vocabularies #}
  {%- if newTypes._value is true -%}
    {%- set newTypesVocabs = newTypes.createVocabularies -%}
    {%- if newTypesVocabs._value is false -%}
      <p>{% trans %}Although we will be using new types of data, suitable public controlled vocabularies or ontologies exist for those.{% endtrans %}</p>
    {%- elif newTypesVocabs._value is true -%}
      {%- set newTypesVocabsMapping = newTypesVocabs.mapping._value -%}
      {%- if newTypesVocabsMapping is false -%}
      <p>{% trans %}We will be using new types of data. For that reason, we will make and publish a vocabulary or ontology for some of our data.{% endtrans %}</p>
      {%- elif newTypesVocabsMapping is true -%}
      <p>{% trans %}We will be using new types of data. For that reason, we will make and publish a vocabulary or ontology for some of our data. Such terms will be mapped to existing vocabularies or ontologies.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}
    {# Design, description and registries of the new data types #}
    {%- set newTypesSentences = [] -%}
    {%- set howDesign = newTypes.howDesign._value -%}
    {%- if howDesign == 'closeFormat' -%}
      {%- do newTypesSentences.append(_("To design our new data formats, we will specialise a closely related, more generic and open format.")) -%}
    {%- elif howDesign == 'ldFormat' -%}
      {%- do newTypesSentences.append(_("To design our new data formats, we will use a Linked Data format.")) -%}
    {%- elif howDesign == 'customFormat' -%}
      {%- do newTypesSentences.append(_("To design our new data formats, we will use a completely custom data format.")) -%}
    {%- endif -%}
    {%- if newTypes.describeForOthers._value is true -%}
      {%- do newTypesSentences.append(_("We will describe our new data formats for others by registering them at a data standards registry.")) -%}
    {%- elif newTypes.describeForOthers._value is false -%}
      {%- do newTypesSentences.append(_("We do not need to describe our new data formats for others.")) -%}
    {%- endif -%}
    {%- set addFields = newTypes.addFields._value -%}
    {%- if addFields == 'no' -%}
      {%- do newTypesSentences.append(_("All of our data types are already described in a data type registry.")) -%}
    {%- elif addFields == 'newFields' -%}
      {%- do newTypesSentences.append(_("We will add new data types to an existing data type registry.")) -%}
    {%- elif addFields == 'newType' -%}
      {%- do newTypesSentences.append(_("We will create our own data type registry.")) -%}
    {%- endif -%}
    {%- set registries = newTypes.registries._value -%}
    {%- if registries -%}
      {#- TRANSLATORS: %(value)s is the answer (free text, possibly several paragraphs) -#}
      {%- do newTypesSentences.append(_("We will use the following data type registries: %(value)s", value=registries|markdown)) -%}
    {%- endif -%}
    {%- if newTypesSentences|length > 0 -%}
      {#- introduce the new types of data unless the paragraph about vocabularies above did -#}
      {%- set vocabsShown = newTypesVocabs._value is false or (newTypesVocabs._value is true and newTypesVocabs.mapping._value is not none) -%}
      {%- if not vocabsShown -%}
        {%- do newTypesSentences.insert(0, _("We will be using new types of data.")) -%}
      {%- endif -%}
      {% call macros.para() %}{{ newTypesSentences|join(' ') }}{% endcall %}
    {%- endif -%}
  {%- endif -%}

  {# Produced datasets (qualified references) #}
  {%- set datasets = [] -%}
  {%- if producedDatasets|length > 0 -%}
    {%- for dataset in producedDatasets -%}
      {%- set producedDataName = dataset.dataset._value -%}
      {# Only published #}
      {%- if dataset.published._value is true -%}
        {# Qualified references #}
        {%- set qualifiedReferences = dataset.published.qualifiedReferences -%}
        {%- if qualifiedReferences._value is true -%}
          {%- set qreferences = [] -%}
          {%- for item in qualifiedReferences.references -%}
            {%- set refId = (item.identifier._value or '')|e -%}
            {%- set refRel = (item.relationship._value or '')|e -%}
            {%- if refId and refRel -%}
              {%- do qreferences.append({
                'id': refId,
                'relation': refRel,
              }) -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if qreferences|length > 0 and producedDataName -%}
            {%- do datasets.append({
              'name': producedDataName,
              'references': qreferences.copy(),
            }) -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if datasets|length > 0 -%}
    <p>{% trans %}The following produced and published datasets will use qualified references:{% endtrans %}</p>
    <ul>
      {%- for dataset in datasets -%}
      <li>
        <strong>{{ dataset.name }}</strong>
        <ul>
          {%- for qref in dataset.references -%}
            <li><em>{{ qref.id|e }}</em> &ndash; {{ qref.relation|markdown }}</li>
          {%- endfor -%}
        </ul>
      </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  </div>
</div>
