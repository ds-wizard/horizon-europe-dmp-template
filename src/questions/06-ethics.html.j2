{#- data -#}
{%- set projectItems = x.administrativeInformation.projects -%}
{%- set datasets = x.preservingData.producedDatasets -%}
{%- set collectPersonal = x.creatingData.collectsPersonalData -%}
{%- set gdpr = collectPersonal.gdpr -%}
{%- set legalBasis = gdpr.legalBasis -%}
{%- set ethics = x.creatingData.collectionEthics -%}
<div id="q-ethical-aspects" class="question">
  <div class="answer">

    {# Research Projects - ethical approval #}
    {%- set projects = [] -%}
    {%- for projectItem in projectItems -%}
      {%- set projectName = projectItem.name._value -%}
      {%- set projectAcronym = projectItem.acronym._value -%}
      {%- if projectName and projectItem.requiresEthicalApproval._value is true -%}
        {%- set projAuth = [] -%}
        {%- for projAuthItem in projectItem.requiresEthicalApproval.authority -%}
          {%- set projAuthStatus = projAuthItem.status._value -%}
          {%- set projAuthCase = projAuthItem.caseNumber._value -%}

          {%- if projAuthCase and projAuthStatus == 'planned' -%}
            {%- do projAuth.append({
              'status': _('planned'),
              'case': projAuthCase,
            }) -%}
          {%- elif projAuthCase and projAuthStatus == 'applied' -%}
            {%- do projAuth.append({
              'status': _('applied'),
              'case': projAuthCase,
            }) -%}
          {%- elif projAuthCase and projAuthStatus == 'granted' -%}
            {%- do projAuth.append({
              'status': _('granted'),
              'case': projAuthCase,
            }) -%}
          {%- elif projAuthCase and projAuthStatus == 'rejected' -%}
            {%- do projAuth.append({
              'status': _('rejected'),
              'case': projAuthCase,
            }) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- do projects.append({
          'name': projectName,
          'acronym': projectAcronym,
          'authorities': projAuth,
        }) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if projects|length > 0 -%}
      <h4>{% trans %}Ethical approvals{% endtrans %}</h4>
      <p>{% if projects|length > 1 %}{% trans %}The following projects require ethical approval:{% endtrans %}{% else %}{% trans %}The following project requires ethical approval:{% endtrans %}{% endif %}</p>
      <ul>
      {%- for project in projects -%}
        <li>
          <strong>{{ project.name }}</strong>{% if project.acronym %} ({{ project.acronym }}){% endif %}
          {% if project.authorities|length > 0 %}
          <ul>
            {% for authority in project.authorities %}
              <li>{% trans case=authority.case, status=authority.status %}case number: <em>{{ case }}</em>, status: <em>{{ status }}</em>{% endtrans %}</li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
      {%- endfor -%}
      </ul>
    {%- endif -%}

    {# Produced datasets #}
    {%- if datasets|length > 0 -%}
      <h4>{% trans %}Data we produce{% endtrans %}</h4>
      <p>{% trans %}For the data we produce, the ethical aspects are as follows:{% endtrans %}</p>
      <ul>
      {%- for dataset in datasets -%}
        {%- set producedDataName = dataset.dataset._value -%}
        {%- set containPersonal = dataset.containsPersonalData._value -%}
        {%- set containSensitive = dataset.containsSensitiveInformation._value -%}
        <li>
          <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong>
          {%- if containPersonal is not none or containSensitive is not none -%}
            <ul>
            {%- if containPersonal is false -%}
              <li>{% trans %}It does not contain personal data.{% endtrans %}</li>
            {%- elif containPersonal is true -%}
              <li>{% trans %}It contains personal data.{% endtrans %}</li>
            {%- endif -%}
            {%- if containSensitive is false -%}
              <li>{% trans %}It does not contain sensitive data.{% endtrans %}</li>
            {%- elif containSensitive is true -%}
              <li>{% trans %}It contains sensitive data.{% endtrans %}</li>
            {%- endif -%}
            </ul>
          {%- else %}
          <span class="separator">&ndash;</span> <em>{% trans %}no information on personal or sensitive data.{% endtrans %}</em>
          {%- endif -%}
        </li>
      {%- endfor -%}
      </ul>
    {%- endif -%}

    {# Collected data - personal/GDPR and ethical legislation #}
    {%- if collectPersonal._value is not none or ethics._value is not none -%}
      <h4>{% trans %}Data we collect{% endtrans %}</h4>

      {%- if collectPersonal._value is false %}
        <p>{% trans %}We will not collect any data related to individuals, i.e. "personal data".{% endtrans %}</p>
      {%- elif collectPersonal._value is true %}
        {%- set sentences = [_('We will collect data related to individuals, i.e. "personal data".')] -%}
        {%- if gdpr._value == 'explore' -%}
          {%- do sentences.append(_('We explored General Data Protection Regulation (GDPR) considerations and relevant materials.')) -%}

          {# legal base #}
          {%- if legalBasis._value == 'publicInterest' -%}
            {%- do sentences.append(_('We collect personal data for the benefit of society, and this is more important than the privacy of the subjects (i.e. public interest).')) -%}
          {%- elif legalBasis._value == 'consent' -%}
            {%- do sentences.append(_('We ask the data subjects for their consent.')) -%}

            {%- set consentKind = legalBasis.whatKind._value -%}
            {%- if consentKind == 'specificUse' -%}
              {%- do sentences.append(_('We collect consent for our specific use of the data.')) -%}
            {%- elif consentKind == 'useAndReuse' -%}
              {%- do sentences.append(_('We collect consent for our use as well as for reuse of the data.')) -%}
            {%- elif consentKind == 'useAndAnonymisation' -%}
              {%- do sentences.append(_('We will collect consent for our use of the data and for anonymization; we will anonymize the data afterwards for reuse.')) -%}
            {%- elif consentKind == 'anonymization' -%}
              {%- do sentences.append(_('We ask for consent for anonymization; we will anonymize first and all further processing is on the anonymous data.')) -%}
            {%- endif -%}

            {%- set cpersExplainInformed = legalBasis.howInformed._value -%}
            {%- if cpersExplainInformed -%}
              {%- do sentences.append(_('The data subjects will be informed as follows:')) -%}
              {%- do sentences.append(cpersExplainInformed|markdown) -%}
            {%- endif -%}

            {%- set reusersAvailable = legalBasis.reusersAvailable._value -%}
            {%- if reusersAvailable is false -%}
              {%- do sentences.append(_('The consent form will not be available for re-users.')) -%}
            {%- elif reusersAvailable is true -%}
              {%- do sentences.append(_('The consent form will be available for re-users.')) -%}
            {%- endif -%}

            {%- set cpersDescribeProcedure = legalBasis.procedures._value -%}
            {%- if cpersDescribeProcedure -%}
              {%- do sentences.append(_('The procedure for obtaining consent from data subjects is set as follows:')) -%}
              {%- do sentences.append(cpersDescribeProcedure|markdown) -%}
            {%- endif -%}

          {%- elif legalBasis._value == 'other' -%}
            {%- do sentences.append(_('We use a legal basis other than public interest or consent for the collection of personal data:')) -%}

            {%- set otherLegalBasis = legalBasis.other._value -%}
            {%- if otherLegalBasis == 'contract' -%}
              {%- do sentences.append(_('to fulfil a contract.')) -%}
            {%- elif otherLegalBasis == 'legitimateInterest' -%}
              {%- do sentences.append(_('legitimate interest.')) -%}
            {%- elif otherLegalBasis == 'vitalInterest' -%}
              {%- do sentences.append(_('vital interest.')) -%}
            {%- elif otherLegalBasis == 'legalRequirement' -%}
              {%- do sentences.append(_('legal requirement.')) -%}
            {%- endif -%}

          {%- endif -%}

          {# purpose  #}
          {%- set cpersGdprPurpose = gdpr.purpose._value -%}
          {%- if cpersGdprPurpose -%}
            {%- do sentences.append(_('The purpose of processing the personal data can be described as follows:')) -%}
            {%- do sentences.append(cpersGdprPurpose|markdown) -%}
          {%- endif -%}

          {# DPIA #}
                    {%- if gdpr.needDpia._value is true %}
            {%- do sentences.append(_('We need to conduct a data protection impact assessment (DPIA).')) -%}
          {%- endif -%}
        {%- endif -%}

        {% call macros.para() %}{{ sentences|join(' ') }}{% endcall %}

        {%- if gdpr._value == 'explore' -%}
          {# rights of the data subjects #}
          {%- if legalBasis._value == 'consent' -%}
            {%- set rights = [] -%}
            {%- for choice in legalBasis.howRights -%}
              {%- if choice._value == 'accessDuring' -%}
                {%- do rights.append(_('access the data during the project')) -%}
              {%- elif choice._value == 'accessAfter' -%}
                {%- do rights.append(_("access the data after the project's completion")) -%}
              {%- elif choice._value == 'modifyAfter' -%}
                {%- do rights.append(_("ask for the data to be modified after the project's completion, which may include their deletion")) -%}
              {%- elif choice._value == 'accessModifiedDuring' -%}
                {%- do rights.append(_('ask for data access to be modified during the project')) -%}
              {%- elif choice._value == 'accessModifiedAfter' -%}
                {%- do rights.append(_("ask for data access to be modified after the project's completion")) -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if rights|length > 0 %}
            {#- TRANSLATORS: rights is an enumeration of what the data subjects can do, e.g. "access the data during the project and ask for data access to be modified during the project" #}
            <p>{% trans rights=macros.joinAnd(rights) %}To exercise their rights to their data, the data subjects can {{ rights }}.{% endtrans %}</p>
            {%- endif -%}
          {%- endif -%}

          {# data controllers #}
          {%- set controllers = gdpr.controllers -%}
          {%- set controllerNames = [] -%}
          {%- for controller in controllers.controllers if controller.organisation._value -%}
            {#- ROR item, or the text of the reply when the item has no ROR names -#}
            {%- set orgName = macros.ror(controller.organisation)|trim -%}
            {%- do controllerNames.append('<strong>'|safe ~ (orgName if orgName else controller.organisation._value) ~ '</strong>'|safe) -%}
          {%- endfor -%}
          {%- set moreThanOne = controllers.moreThanOne -%}
          {%- set jointController = moreThanOne.jointController -%}
          {%- if controllerNames|length > 0 or moreThanOne._value is not none %}
            <p>
            {%- if controllerNames|length > 0 %}
              {#- TRANSLATORS: controllers is an enumeration of organisations #}
              {% trans count=controllerNames|length, controllers=macros.joinAnd(controllerNames) %}The data controller of the personal data is {{ controllers }}.{% pluralize %}The data controllers of the personal data are {{ controllers }}.{% endtrans %}
            {%- endif -%}
            {%- if moreThanOne._value is false and controllerNames|length == 0 %}
              {% trans %}There is only one data controller of the personal data.{% endtrans %}
            {%- elif moreThanOne._value is true and controllerNames|length < 2 %}
              {% trans %}There is more than one data controller of the personal data.{% endtrans %}
            {%- endif -%}
            {%- if moreThanOne._value is true -%}
              {%- if jointController._value is false %}
                {% trans %}They will not be joint controllers.{% endtrans %}
              {%- elif jointController._value is true %}
                {% trans %}They will be joint controllers.{% endtrans %}
                {%- if jointController.agreement._value is true %}
                  {% trans %}A joint controllership agreement between them has been established.{% endtrans %}
                {%- elif jointController.agreement._value is false %}
                  {% trans %}A joint controllership agreement between them has not been established yet.{% endtrans %}
                {%- endif -%}
              {%- endif -%}
            {%- endif %}
            </p>
          {%- endif -%}

          {# data processing agreements #}
          {%- set dpa = gdpr.dataProcessingAgreement -%}
          {%- if dpa._value == 'notRelevant' %}
            <p>{% trans %}Data processing agreements with data processors are not relevant for our project.{% endtrans %}</p>
          {%- elif dpa._value == 'notYet' %}
            <p>{% trans %}Data processing agreements between the data controllers and the data processors will be established before the processing starts.{% endtrans %}</p>
          {%- elif dpa._value == 'yes' -%}
            {%- set processors = dpa.processors|selectattr('processor._value')|list -%}
            {%- if processors|length > 0 %}
            <p>{% trans %}Data processing agreements have been established with the following data processors:{% endtrans %}</p>
            <ul>
              {%- for processor in processors %}
              <li><strong>{{ processor.processor._value }}</strong>
                {%- if processor.agreement._value %}: {{ processor.agreement._value }}{% endif %}</li>
              {%- endfor %}
            </ul>
            {%- else %}
            <p>{% trans %}Data processing agreements have been established between the data controllers and the data processors.{% endtrans %}</p>
            {%- endif -%}
          {%- endif -%}

          {# DPIA details #}
          {%- set dpiaDone = gdpr.needDpia.dpiaDone -%}
          {%- if gdpr.needDpia._value is true -%}
            {%- if dpiaDone._value is false %}
            <p>{% trans %}The DPIA has not been performed yet.{% endtrans %}</p>
            {%- elif dpiaDone._value is true -%}
              {%- set reasons = [] -%}
              {%- for choice in dpiaDone.whyNecessary -%}
                {%- if choice._value == 'vulnerableDataSubjects' -%}
                  {%- do reasons.append(_('data concerning vulnerable data subjects')) -%}
                {%- elif choice._value == 'highlyPersonalNature' -%}
                  {%- do reasons.append(_('sensitive data or data of a highly personal nature')) -%}
                {%- elif choice._value == 'largeScale' -%}
                  {%- do reasons.append(_('data processing on a large scale')) -%}
                {%- elif choice._value == 'legalEffect' -%}
                  {%- do reasons.append(_('automated decision-making with legal or similarly significant effects on the data subjects')) -%}
                {%- elif choice._value == 'subjectPerformance' -%}
                  {%- do reasons.append(_('evaluation or scoring of the data subjects')) -%}
                {%- elif choice._value == 'systematicMonitoring' -%}
                  {%- do reasons.append(_('systematic monitoring of the data subjects')) -%}
                {%- elif choice._value == 'matchingCombining' -%}
                  {%- do reasons.append(_('matching or combining datasets')) -%}
                {%- elif choice._value == 'physicalAccessControl' -%}
                  {%- do reasons.append(_('innovative use of new technological or organisational solutions')) -%}
                {%- elif choice._value == 'preventsRights' -%}
                  {%- do reasons.append(_('processing that prevents the data subjects from exercising a right or using a service or a contract')) -%}
                {%- endif -%}
              {%- endfor -%}
              {%- set dpias = dpiaDone.dpias|selectattr('dataset._value')|list -%}
              {%- if reasons|length > 0 %}
              {#- TRANSLATORS: reasons is an enumeration of the kinds of processing that make a DPIA necessary, e.g. "data processing on a large scale and matching or combining datasets" #}
              <p>{% trans reasons=macros.joinAnd(reasons) %}A DPIA is necessary because the project involves {{ reasons }}.{% endtrans %}</p>
              {%- endif -%}
              {%- if dpias|length > 0 %}
              <p>{% trans %}We have performed DPIAs for the following data:{% endtrans %}</p>
              <ul>
                {%- for item in dpias %}
                <li><strong>{{ item.dataset._value }}</strong>
                  {%- if item.dpia._value %}: {{ item.dpia._value }}{% endif %}</li>
                {%- endfor %}
              </ul>
              {%- else %}
              <p>{% trans %}The DPIA has been performed.{% endtrans %}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {% if ethics._value is false %}
      <p>{% trans %}The data collection is not subject to ethical legislation.{% endtrans %}</p>
      {% elif ethics._value is true %}
        {%- set ethicalReview = ethics.coveredByEthicalReview._value -%}
        {%- set humanData = ethics.involvesHumanData._value -%}
        <p>
          {% trans %}The data collection is subject to ethical legislation.{% endtrans %}
          {% if ethicalReview is false %}
          {% trans %}It is not covered by ethical review.{% endtrans %}
          {% elif ethicalReview is true %}
          {% trans %}It is covered by ethical review.{% endtrans %}
          {% endif %}
          {% if humanData is false %}
          {% trans %}It does not involve human subjects.{% endtrans %}
          {% elif humanData is true %}
          {% trans %}It involves human subjects.{% endtrans %}
          {% endif %}
        </p>
        {%- if humanData is true -%}
          {%- if ethics.involvesHumanData.consent._value is true %}
        <p>{% trans %}Informed consent has been collected from the research subjects.{% endtrans %}</p>
          {%- elif ethics.involvesHumanData.consent._value is false %}
        <p>{% trans %}Informed consent has not been collected from the research subjects.{% endtrans %}</p>
          {%- endif -%}
        {%- endif %}
      {% endif %}
    {%- endif -%}

    {# Re-used data - personal data and ethical approval #}
    {%- set reusedDatasets = [] -%}
    {%- if x.reusingData.hasPreExistingData._value is true -%}
      {%- for nrefData in x.reusingData.hasPreExistingData.nonReferenceDatasets -%}
        {%- set nrefDataUse = nrefData.using -%}
        {%- if nrefDataUse._value is true and (nrefDataUse.includesPersonalData._value is not none or nrefDataUse.needsEthicalApproval._value is not none) -%}
          {%- do reusedDatasets.append(nrefData) -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if reusedDatasets|length > 0 -%}
      <h4>{% trans %}Re-used data{% endtrans %}</h4>
      <ul>
      {%- for nrefData in reusedDatasets -%}
        {%- set nrefDataName = nrefData.dataset._value -%}
        {%- set nrefDataUse = nrefData.using -%}
        {%- set nrefDataPersonal = nrefDataUse.includesPersonalData -%}
        {%- set nrefDataEthicalApproval = nrefDataUse.needsEthicalApproval._value %}
        <li>
          <strong>{{ nrefDataName if nrefDataName else _("(no name given)") }}</strong>
          {%- if nrefDataPersonal._value is false %}
          <p>{% trans %}This data do not include personal data.{% endtrans %}</p>
          {%- elif nrefDataPersonal._value is true %}
          <p>
            {% trans %}This data include personal data{% endtrans %}
            {%- set nrefLegalBasis = nrefDataPersonal.legalBasis -%}
            {%- if nrefLegalBasis._value is not none -%}
              {% trans %}, legally based on{% endtrans %}{{+" "}}
              {%- if nrefLegalBasis._value == 'publicInterest' -%}
                {% trans %}public interest for processing the data under GDPR.{% endtrans %}
              {%- elif nrefLegalBasis._value == 'consent' -%}
                {% trans %}consent given by the research subject for processing the data under GDPR{% endtrans %}
                {%- if nrefLegalBasis.isCovered._value is not none -%}
                  {% trans %}, which{% endtrans %}{{+" "}}
                  {%- if nrefLegalBasis.isCovered._value is true -%}
                    {% trans %}also covers our reuse.{% endtrans %}
                  {%- elif nrefLegalBasis.isCovered._value is false -%}
                    {% trans %}does not cover our reuse; therefore, new consent will be needed.{% endtrans %}
                  {%- endif -%}
                {%- else -%}
                .
                {%- endif -%}
              {%- elif nrefLegalBasis._value == 'other' -%}
                {%- set nrefLegalBasisOther = nrefLegalBasis.other._value -%}
                {%- if nrefLegalBasisOther == 'legalRequirement' -%}
                  {% trans %}a legal requirement (meaning a legal obligation to do this data processing).{% endtrans %}
                {%- elif nrefLegalBasisOther == 'vitalInterest' -%}
                  {% trans %}a vital interest (meaning it needs to be done to protect the vital interests of the data subject).{% endtrans %}
                {%- elif nrefLegalBasisOther == 'legitimateInterest' -%}
                  {% trans %}a legitimate interest (meaning data subjects all expect us to do this data processing because of who we are).{% endtrans %}
                {%- elif nrefLegalBasisOther == 'contract' -%}
                  {% trans %}a requirement to fulfill our contract with the data subjects.{% endtrans %}
                {%- else -%}
                  {% trans %}a legal basis other than public interest or consent.{% endtrans %}
                {%- endif -%}
              {%- endif -%}
            {%- else -%}
            .
            {%- endif %}
          </p>
          {%- endif -%}
          {%- if nrefDataEthicalApproval == 'notApplicable' %}
          <p>{% trans %}Ethical approval under research ethics laws is not applicable to this data.{% endtrans %}</p>
          {%- elif nrefDataEthicalApproval == 'covered' %}
          <p>{% trans %}The existing ethical approval under research ethics laws of this non-reference data covers our reuse.{% endtrans %}</p>
          {%- elif nrefDataEthicalApproval == 'extension' %}
          <p>{% trans %}An extension of existing ethical approval under research ethics laws of this non-reference data will be needed.{% endtrans %}</p>
          {%- elif nrefDataEthicalApproval == 'new' %}
          <p>{% trans %}New ethical approval under research ethics laws of this non-reference data will be needed to cover our usage of the data.{% endtrans %}</p>
          {%- endif %}
        </li>
      {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
