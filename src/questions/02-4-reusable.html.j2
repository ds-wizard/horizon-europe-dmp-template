{#- data -#}
{%- set producedDatasets = x.preservingData.producedDatasets -%}
{%- set measured = x.creatingData.hasMeasuredData -%}
{%- set allOpen = x.givingAccessToData.allOpenOverTime -%}
{%- set coldStorage = x.preservingData.coldStorageDuringProject -%}
{%- set validIntegrity = x.processingData.resultsIntegrityValidation -%}
<div id="q-reusable" class="question">
  <div class="answer">
    {# Produced datasets #}
    {%- if producedDatasets|length > 0 -%}
      <p>{% trans %}The metadata for our produced data will be kept as follows:{% endtrans %}</p>
      <ul>
      {%- for dataset in producedDatasets -%}
        {%- set producedDataName = dataset.dataset._value -%}
        <li>
          <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong>
          {# If will be published #}
          {%- set isPublished = dataset.published._value -%}
          {% if isPublished is false %}
            {% trans %}(not published){% endtrans %}
          {% elif isPublished is true %}
            {% trans %}(will be published){% endtrans %}
          {% endif -%}
          {# How long will be stored + Metadata FAIRness #}
          {%- set retention = dataset.retention -%}
          {%- set metadataPersistent = dataset.persistentMetadata._value is true -%}
          {%- if retention._value or metadataPersistent %}
            {% if retention._value == 'asLongAsPossible' -%}
              <span class="separator">&ndash;</span> {% trans %}This data set will be kept available as long as technically possible.{% endtrans %}
            {%- elif retention._value == 'untilDelete' -%}
              <span class="separator">&ndash;</span> {% trans %}This data set will be kept available until it needs to be deleted for legal, contractual or regulatory reasons.{% endtrans %}
            {%- elif retention._value == 'fixedPeriod' -%}
              {%- set publishedDataHowLongFixed = retention.period._value -%}
              <span class="separator">&ndash;</span> {% if publishedDataHowLongFixed %}{% trans period=(publishedDataHowLongFixed|trim|dot) %}This data set will be kept available for a fixed period (prepaid) of {{ period }}{% endtrans %}{% else %}{% trans %}This data set will be kept available for a fixed period (prepaid).{% endtrans %}{% endif %}
            {%- endif -%}
            {%- if metadataPersistent %}
              <span class="separator">&ndash;</span> {% trans %}The metadata will be available even when the data no longer exists.{% endtrans %}
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
      </ul>
    {%- endif -%}

    {# Measure quality #}
    {%- set measuredQuality = [] -%}
    {%- if measured._value is true -%}
      {# Measured datasets #}
      {%- for measuredDataset in measured.datasets -%}
        {%- set mdName = measuredDataset.dataset._value -%}
        {%- set quality = measuredDataset.hasQualityProcesses -%}
        {%- if mdName and quality._value is true -%}
          {%- set mdQOther = quality.other.other._value -%}
          {%- set qCalibrate = quality.calibration._value is true -%}
          {%- set qRepeat = quality.repeat._value is true -%}
          {%- set qStd = quality.standardised._value is true -%}
          {%- set qValid = quality.validation._value is true -%}
          {%- set qPeer = quality.peerReview._value is true -%}
          {%- set qVocab = quality.vocabularies._value is true -%}
          {%- set qConsistency = quality.consistency._value is true -%}
          {%- set qOther = quality.other._value is true -%}
          {%- if qCalibrate or qRepeat or qStd or qValid or qPeer or qVocab or qConsistency or qOther -%}
            {%- do measuredQuality.append({
              'name': mdName,
              'calibrate': qCalibrate,
              'repeat': qRepeat,
              'std': qStd,
              'valid': qValid,
              'peer': qPeer,
              'vocab': qVocab,
              'consistency': qConsistency,
              'other': qOther,
              'othertxt': mdQOther,
            }) -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if measuredQuality|length > 0 -%}
      <p>{% trans count=globals.projectsCount %}The following instrument datasets acquired in the project will use the following quality processes:{% pluralize %}The following instrument datasets acquired in the projects will use the following quality processes:{% endtrans %}</p>
      <ul>
      {%- for item in measuredQuality -%}
        <li>
            <strong>{{ item.name }}</strong>
            <ul>
              {% if item.calibrate %}<li>{% trans %}Calibrating measurements{% endtrans %}</li>{% endif %}
              {% if item.repeat %}<li>{% trans %}Repeat samples / measurements{% endtrans %}</li>{% endif %}
              {% if item.std %}<li>{% trans %}Standardized data capture / recording{% endtrans %}</li>{% endif %}
              {% if item.valid %}<li>{% trans %}Data entry validation{% endtrans %}</li>{% endif %}
              {% if item.peer %}<li>{% trans %}Data peer review{% endtrans %}</li>{% endif %}
              {% if item.vocab %}<li>{% trans %}Use of controlled vocabularies{% endtrans %}</li>{% endif %}
              {% if item.consistency %}<li>{% trans %}Measuring samples for which the outcome is known to monitor consistency{% endtrans %}</li>{% endif %}
              {% if item.other %}<li>{% trans value=(": " ~ item.othertxt|markdown if item.othertxt else "") %}Other quality processes{{ value }}{% endtrans %}</li>{% endif %}
            </ul>
        </li>
      {%- endfor -%}
      </ul>
      {%- endif -%}
    {%- endif -%}

    {# Can open data #}
    {%- if allOpen._value is true -%}
      <p>{% trans %}As stated already in Section 2.2, all of our data can become completely open over time.{% endtrans %}</p>
    {%- elif allOpen._value is false -%}
      <p>{% trans %}As explained in Section 2.2, our data cannot become completely open.{% endtrans %}</p>

      {%- set notOpenSentences = [] -%}
      {%- set notOpenSentencesIP = [] -%}
      {%- set notOpenSentencesDP = [] -%}
      {%- set legalReasons = allOpen.legalReasons -%}
      {%- if legalReasons._value is true -%}
        {%- set legalPrivacy = legalReasons.privacyReasons -%}
        {%- if legalPrivacy._value is true -%}
          {%- set legalPrivacyWhere = legalPrivacy.storageRestrictions._value -%}
          {%- set legalPrivacyPseudo = legalPrivacy.pseudonymization._value -%}
          {%- set legalPrivacyAnon = legalPrivacy.anonymisation._value -%}
          {%- set legalPrivacyAggr = legalPrivacy.aggregation._value -%}

          {%- if legalPrivacyWhere == 'none' -%}
            {%- do notOpenSentences.append(_("There are no restrictions on where the data need to be stored for privacy reasons.")) -%}
          {%- elif legalPrivacyWhere == 'eu' -%}
            {%- do notOpenSentences.append(_("Due to privacy reasons, the data must stay in the EU.")) -%}
          {%- elif legalPrivacyWhere == 'country' -%}
            {%- do notOpenSentences.append(_("Due to privacy reasons, the data must stay in the same country.")) -%}
          {%- elif legalPrivacyWhere == 'institute' -%}
            {%- do notOpenSentences.append(_("Due to privacy reasons, the data must stay in the same institute.")) -%}
          {%- endif -%}
          {%- set privacyCanUse = [] -%}
          {%- set privacyCannotUse = [] -%}
          {%- if legalPrivacyPseudo is false -%}
            {%- do privacyCannotUse.append(_("pseudonymization")) -%}
          {%- elif legalPrivacyPseudo is true -%}
            {%- do privacyCanUse.append(_("pseudonymization")) -%}
          {%- endif -%}
          {%- if legalPrivacyAnon is false -%}
            {%- do privacyCannotUse.append(_("anonymization")) -%}
          {%- elif legalPrivacyAnon is true -%}
            {%- do privacyCanUse.append(_("anonymization")) -%}
          {%- endif -%}
          {%- if legalPrivacyAggr is false -%}
            {%- do privacyCannotUse.append(_("data aggregation")) -%}
          {%- elif legalPrivacyAggr is true -%}
            {%- do privacyCanUse.append(_("data aggregation")) -%}
          {%- endif -%}

          {#- TRANSLATORS: %(methods)s is an enumeration of pseudonymization, anonymization, and data aggregation -#}
          {%- if privacyCanUse|length > 0 -%}
            {%- do notOpenSentences.append(_("We can use %(methods)s to make the data more openly available.", methods=macros.joinAnd(privacyCanUse))) -%}
          {%- endif -%}
          {%- if privacyCannotUse|length == 1 and privacyCanUse|length == 0 -%}
            {%- do notOpenSentences.append(_("We cannot use %(method)s to make the data more openly available.", method=privacyCannotUse[0])) -%}
          {%- elif privacyCannotUse|length == 1 -%}
            {%- do notOpenSentences.append(_("But we cannot use %(method)s to make the data more openly available.", method=privacyCannotUse[0])) -%}
          {%- elif privacyCannotUse|length > 1 and privacyCanUse|length == 0 -%}
            {%- do notOpenSentences.append(_("We can use neither %(methods)s to make the data more openly available.", methods=macros.joinNor(privacyCannotUse))) -%}
          {%- elif privacyCannotUse|length > 1 -%}
            {%- do notOpenSentences.append(_("But we can use neither %(methods)s to make the data more openly available.", methods=macros.joinNor(privacyCannotUse))) -%}
          {%- endif -%}

          {%- if legalPrivacyPseudo is true -%}
            {%- set legalPrivacyPseudoParty = legalPrivacy.pseudonymization.trustedThirdParty._value -%}
            {%- if legalPrivacyPseudoParty is false -%}
              {%- do notOpenSentences.append(_("For pseudonymization, we cannot make use of an existing 'trusted third party'.")) -%}
            {%- elif legalPrivacyPseudoParty is true -%}
              {%- do notOpenSentences.append(_("For pseudonymization, we can make use of an existing 'trusted third party'.")) -%}
            {%- endif -%}
          {%- endif -%}

          {# Access to private data #}
          {%- set personalDataManagedAccessReply = legalPrivacy.procedure._value -%}
          {%- if personalDataManagedAccessReply -%}
            {% call macros.para() %}{% trans value=(personalDataManagedAccessReply|trim|dot) %}There is a procedure for users to access private data as follows: {{ value }}{% endtrans %}{% endcall %}
          {%- endif -%}

        {%- endif -%}
        
        {%- set legalIp = legalReasons.ipReasons -%}
        {%- if legalIp._value is false -%}
          {%- do notOpenSentencesIP.append(_("There are no IP reasons why our data cannot be open.")) -%}
        {%- elif legalIp._value is true -%}
          {%- do notOpenSentencesIP.append(_("There are IP reasons why our data cannot be open.")) -%}
        
          {%- if legalIp.clearOwnership._value is true -%}
            {%- do notOpenSentencesIP.append(_("It is clear who owns data and documents.")) -%}
          {%- endif -%}
          {%- if legalIp.powerToMove._value is true -%}
            {%- do notOpenSentencesDP.append(ngettext("Someone will be given the decision power to move documents or data to a new place after the project has finished.", "Someone will be given the decision power to move documents or data to a new place after the projects have finished.", globals.projectsCount)) -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {%- if notOpenSentences|length > 0 -%}
        <p>{{ notOpenSentences|join(" ") }}</p>
      {%- endif -%}
      {%- if notOpenSentencesIP|length > 0 -%}
        <p>{{ notOpenSentencesIP|join(" ") }}</p>
      {%- endif -%}
      {%- if notOpenSentencesDP|length > 0 -%}
        <p>{{ notOpenSentencesDP|join(" ") }}</p>
      {%- endif -%}
    {%- endif -%}

    {# Cold storage #}
    {%- if coldStorage._value is false -%}
      <p>{% trans count=globals.projectsCount %}We do not plan to be archiving data in <em>cold storage</em> systems for long-term preservation already during the project.{% pluralize %}We do not plan to be archiving data in <em>cold storage</em> systems for long-term preservation already during the projects.{% endtrans %}</p>
    {%- elif coldStorage._value is true -%}
      {%- set coldStorageReusable = coldStorage.longTermUnderstandable._value -%}
      {%- if coldStorageReusable is false -%}
        <p>{% trans count=globals.projectsCount %}We will be archiving data in <em>cold storage</em> systems for long-term preservation already during the project.{% pluralize %}We will be archiving data in <em>cold storage</em> systems for long-term preservation already during the projects.{% endtrans %}</p>
      {%- elif coldStorageReusable is true -%}
        <p>{% trans count=globals.projectsCount %}We will be archiving data in <em>cold storage</em> systems for long-term preservation already during the project. The data are expected to remain interpretable and reusable over time.{% pluralize %}We will be archiving data in <em>cold storage</em> systems for long-term preservation already during the projects. The data are expected to remain interpretable and reusable over time.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}

    {# Validating the integrity of the results #}
    {%- if validIntegrity._value == 'explore' -%}

      {%- set validateHow = [] -%}
      {%- if validIntegrity.acrossComputeInfrastructures._value is true -%}
        {%- do validateHow.append(_("We will run a subset of our jobs several times across the different compute infrastructures.")) -%}
      {%- endif -%}
      {%- if validIntegrity.instrumentingPipelinesWorkflowsAutomatically._value is true -%}
        {%- do validateHow.append(_("We will be instrumenting the tools into pipelines and workflows using automated tools.")) -%}
      {%- endif -%}
      {%- if validIntegrity.independentDuplicateToolsWorkflows._value is true -%}
        {%- do validateHow.append(_("We will use independently developed duplicate tools or workflows for critical steps to reduce or eliminate human errors.")) -%}
      {%- endif -%}
      {%- if validIntegrity.runPartsRepeatedly._value is true -%}
        {%- do validateHow.append(_("We will run part of the data set repeatedly to catch unexpected changes in results.")) -%}
      {%- endif -%}
      {%- if validateHow|length > 0 -%}
      <p>{% trans %}To validate the integrity of the results, the following will be done:{% endtrans %}</p>
      <ul>
        {% for vh in validateHow -%}<li>{{ vh }}</li>{%- endfor -%}
      </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
