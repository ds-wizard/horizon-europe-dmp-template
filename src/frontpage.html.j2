{%- set eu_header = assets("assets/eu-header.png") -%}
{%- set eu_flag = assets("assets/eu-flag.png") -%}
<header>
  <div class="logo">
  <img src="{{ eu_header.data_url }}" height="78" width="160" class="eu-header" alt="" />
  </div>
  <h1>{{ ctx.project.name }}</h1>
  <div class="logo">
  <img src="{{ eu_flag.data_url }}" height="213" width="320" class="eu-flag" alt="" />
  </div>
  <h3>
    {% trans %}Horizon Europe<br/>
    Data Management Plan{% endtrans %}
  </h3>

  <div class="info">
    <div class="version-info">
      {% for version in dc.questionnaire.versions if dc.questionnaire.version and version.uuid == dc.questionnaire.version.uuid %}
        <div class="version">{{version.name}}</div>
      {% endfor %}
      <div class="date">{{ macros.formatDate(dc.document.created_at, full=true) }}</div>
    </div>

    {%- set serviceLink -%}<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_domain_name }}</a>{%- endset -%}
    {%- set packageId -%}<span class="package-id">{{ dc.km_package.id }}:{{ dc.km_package.version }}</span>{%- endset %}
    {#- no package in a preview of the knowledge model editor #}
    {%- if dc.km_package %}
    <p class="note">
      {# TRANSLATORS: %(link)s is the domain of the Wizard as a link, %(name)s and %(version)s the knowledge model, %(id)s its ID #}
      {% trans service_name=dc.config.service_name, link=serviceLink, name=dc.km_package.name, version=dc.km_package.version, id=packageId %}Data Management Plan created in {{ service_name }} &laquo;{{ link }}&raquo;<br/> using {{ name }} v{{ version }} ({{ id }}).{% endtrans %}
    </p>
    {%- endif %}
  </div>
</header>
